<?xml version="1.0"?>
<psalm
    errorLevel="8"
    resolveFromConfigFile="true"
    findUnusedCode="false"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="src" />
        <directory name="front" />
        <directory name="ajax" />
        <file name="hook.php" />
        <file name="setup.php" />
        <ignoreFiles>
            <directory name="vendor" />
            <directory name="tests" />
        </ignoreFiles>
    </projectFiles>

    <!--
        GLPI core is unavailable inside the security-scan container. Stub the
        classes the plugin extends so Psalm can resolve parent chains instead of
        crashing on "Could not get class storage".
    -->
    <stubs>
        <file name="stubs/glpi-core.php" />
    </stubs>

    <!--
        Without GLPI source, references to core classes/methods/constants are
        unknown. Suppress those so the run stays focused on taint (security)
        findings; taint issues are still reported regardless of these handlers.
    -->
    <issueHandlers>
        <UndefinedClass errorLevel="suppress" />
        <UndefinedDocblockClass errorLevel="suppress" />
        <UndefinedMethod errorLevel="suppress" />
        <UndefinedFunction errorLevel="suppress" />
        <UndefinedConstant errorLevel="suppress" />
        <UndefinedPropertyFetch errorLevel="suppress" />
        <UndefinedPropertyAssignment errorLevel="suppress" />
        <UndefinedThisPropertyFetch errorLevel="suppress" />
        <UndefinedThisPropertyAssignment errorLevel="suppress" />
        <UndefinedGlobalVariable errorLevel="suppress" />

        <!--
            The reusable GLPI CI (plugin-ci-workflows) runs psalm in full analysis
            mode against the real GLPI core (taint analysis is not enabled there).
            That surfaces non-security correctness/style issues the taint-focused
            security scan never reports. Suppress them so both runs stay green
            without a separate baseline file; none of these are taint findings,
            so the security scan is unaffected.
              MissingOverrideAttribute: Override attribute hints on inherited methods.
              InvalidGlobal: `global $DB` at file scope in front/ajax entry points,
                which GLPI's router legitimately includes from a non-global scope.
              NoValue, InvalidParamDefault, MissingTemplateParam: pre-existing
                inference artifacts and core-inherited docblock signatures.
        -->
        <MissingOverrideAttribute errorLevel="suppress" />
        <InvalidGlobal errorLevel="suppress" />
        <NoValue errorLevel="suppress" />
        <InvalidParamDefault errorLevel="suppress" />
        <MissingTemplateParam errorLevel="suppress" />
    </issueHandlers>
</psalm>
