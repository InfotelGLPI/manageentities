includes:
    - ../../vendor/glpi-project/phpstan-glpi/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - ajax
        - front
        - install
        - src
        - hook.php
        - setup.php
    scanDirectories:
        - ../../inc
        - ../../src
    scanFiles:
        # Local stub for the optional datainjection plugin (see the stub header).
        # Keeps analysis independent of where datainjection lives, or if absent.
        - tools/phpstan-stubs/datainjection.php
    bootstrapFiles:
        - ../../stubs/glpi_constants.php
        - ../../vendor/autoload.php
        - setup.php
    treatPhpDocTypesAsCertain: false
    # The CI runner analyzes a pristine GLPI 11.0.x core while the local tree may
    # carry core modifications, so PHPStan's type narrowing (and baseline hit counts)
    # can differ between the two. Tolerate baseline entries that do not reproduce on
    # the runner instead of failing on the drift.
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # CI-only drift: on the pristine runner core, Company::getLogo()'s return
        # (Document::$fields['filepath'], a varchar column, always a string) is
        # inferred as an array, so PHPStan flags the GLPI_DOC_DIR concatenation.
        # It never holds an array at runtime, so this is not a real defect.
        -
            message: '#^Binary operation "\." between .+ and non\-empty\-array<mixed> results in an error\.$#'
            identifier: binaryOp.invalid
            path: src/CriPDF.php
