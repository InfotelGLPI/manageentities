{# Preview of the generated intervention report, and the button saving it (manageentities_loadCriForm) #}
<form method="post" name="formReport">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    {% for name, value in hidden_fields %}
        <input type="hidden" name="{{ name }}" value="{{ value }}">
    {% endfor %}
    <p>
        <input type="button" name="save_cri" value="{{ __('Save the intervention report', 'manageentities') }}"
               class="submit btn btn-primary manageentities_button" onclick="{{ save_onclick }}">
    </p>
    <iframe style="width:500px;height:700px" src="{{ preview_url }}" scrolling="no" frameborder="1"></iframe>
</form>
