{# Result of the moving report (Report::showMovingReports()), numbers formatted by the caller #}
<div class="card mt-3">
    <div class="card-header">
        <h3 class="card-title">
            <i class="ti ti-car me-1"></i>
            {{ __('Report on the movement of technicians', 'manageentities') }}
        </h3>
    </div>
    <div class="table-responsive">
        <table class="table table-sm table-hover table-vcenter card-table">
            <thead>
                <tr>
                    <th>{{ _n('Entity', 'Entities', 1) }}</th>
                    <th class="text-end">{{ __('Total moving package', 'manageentities') }}</th>
                    <th class="text-end">{{ __('Total time of the tasks of a category', 'manageentities') }}</th>
                    <th class="text-end">{{ __('Total') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                    <tr>
                        <td>{{ row.entity }}</td>
                        <td class="text-end">{{ row.total_depl }}</td>
                        <td class="text-end">{{ row.actiontime }}</td>
                        <td class="text-end fw-bold">{{ row.total }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
