<form action="{{ form_url }}" method="post">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    <div class="modal" tabindex="-1" id="directhelpdesk-modal">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="ti ti-file-euro me-2"></i>
                        {{ __('Add an unbilled intervention', 'manageentities') }}
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                            aria-label="{{ __('Close') }}"></button>
                </div>
                <div class="modal-body">
                    <table class="tab_cadre">
                        <tr class="tab_bg_1">
                            <td>{{ entity_type }} <span class="red">*</span></td>
                            <td>
                                {{ entity_dropdown|raw }}
                                {{ js_block|raw }}
                            </td>
                        </tr>
                        <span id="entity_alert">{{ alert|raw }}</span>
                        <tr class="tab_bg_1">
                            <td>{{ __('Title') }} <span class="red">*</span></td>
                            <td>{{ category_dropdown|raw }}</td>
                        </tr>
                        <tr class="tab_bg_1">
                            <td>{{ __('Description') }} </td>
                            <td colspan="4">{{ comment_textarea|raw }}</td>
                        </tr>
                        <tr class="tab_bg_1">
                            <td>{{ __('Date') }} <span class="red">*</span></td>
                            <td>{{ date_field|raw }}</td>
                        </tr>
                        <tr class="tab_bg_1">
                            <td>
                                <i class="ti ti-clock-stop me-1" title="{{ __('Duration') }}"> </i>
                                <span class="red">*</span>
                            </td>
                            <td>{{ time_field|raw }}</td>
                        </tr>
                        <tr class="tab_bg_1">
                            <td><i class="ti ti-ticket me-1" title="{{ __('Linked ticket') }}"></i></td>
                            <td>{{ ticket_dropdown|raw }}</td>
                        </tr>
                        <tr class="tab_bg_1 center">
                            <td>
                                {{ users_hidden|raw }}
                                <button type="submit" name="add" class="btn btn-primary">
                                    {{ _x('button', 'Post') }}
                                </button>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
</form>
