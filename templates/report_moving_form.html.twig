{% import 'components/form/fields_macros.html.twig' as fields %}

{% set row = {'field_class': 'col-12', 'label_class': 'col-sm-4', 'input_class': 'col-sm-8', 'align_label_right': false} %}

<div class="center">
<form name="form" method="post" action="{{ form_url }}">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    <div class="card mb-3 mx-auto" style="max-width: 700px;">
        <div class="card-header d-flex align-items-center gap-2">
            <i class="ti ti-calendar-stats"></i>
            <strong>{{ __('Moving report', 'manageentities') }}</strong>
        </div>
        <div class="card-body">
            {{ fields.dateField('date1', date1, __('Start date'), row) }}
            {{ fields.dateField('date2', date2, __('End date'), row) }}

            <hr>

            {{ fields.dropdownArrayField('entities_id', null, entities, _n('Entity', 'Entities', 1), row|merge({
                'multiple': true,
                'values': entities_selected,
            })) }}
            {{ fields.dropdownField('TaskCategory', 'category_id', category_id, __('Task category'), row) }}
        </div>
        <div class="card-footer d-flex justify-content-end">
            <button type="submit" name="send" class="btn btn-primary">
                <i class="ti ti-search me-1"></i>{{ _x('button', 'Post') }}
            </button>
        </div>
    </div>
</form>
</div>
