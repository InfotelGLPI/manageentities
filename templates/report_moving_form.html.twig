<form name="form" method="post" action="{{ form_url }}">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    <div class="card mb-3 mx-auto" style="max-width: 700px;">
        <div class="card-header d-flex align-items-center gap-2">
            <i class="ti ti-calendar-stats"></i>
            <strong>{{ __('Moving report', 'manageentities') }}</strong>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <label class="col-sm-4 col-form-label" for="date1">{{ __('Start date') }}</label>
                <div class="col-sm-8">{{ date1_field|raw }}</div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-4 col-form-label" for="date2">{{ __('End date') }}</label>
                <div class="col-sm-8">{{ date2_field|raw }}</div>
            </div>

            <hr>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">{{ _n('Entity', 'Entities', 1) }}</label>
                <div class="col-sm-8">{{ entities_dropdown|raw }}</div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">{{ __('Task category') }}</label>
                <div class="col-sm-8">{{ category_dropdown|raw }}</div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-end">
            <button type="submit" name="send" class="btn btn-primary">
                <i class="ti ti-search me-1"></i>{{ _x('button', 'Post') }}
            </button>
        </div>
    </div>
</form>
