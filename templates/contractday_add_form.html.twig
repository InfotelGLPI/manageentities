{# "Add a service period" button; rendered alone in a card when the contract has no period yet #}
{% set add_form %}
<form method="post" name="contractDays_form{{ add_rand }}" id="contractDays_form{{ add_rand }}" action="{{ add_url }}">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    <input type="hidden" name="contract_id" value="{{ contract_id }}">
    <input type="hidden" name="id" value="">
    <button type="submit" name="addperiod" class="btn btn-primary">
        <i class="ti ti-plus me-1"></i>
        {{ __('Add a service period', 'manageentities') }}
    </button>
</form>
{% endset %}

{% if empty_card|default(false) %}
<div class="card mt-3">
    <div class="card-body d-flex align-items-center gap-3">
        <i class="ti ti-calendar-plus fs-2 text-muted"></i>
        <div>
            <div class="fw-bold">{{ _n('Period of contract', 'Periods of contract', 2, 'manageentities') }}</div>
            <div class="text-muted">{{ __('No service period defined yet.', 'manageentities') }}</div>
        </div>
        <div class="ms-auto">{{ add_form }}</div>
    </div>
</div>
{% else %}
{{ add_form }}
{% endif %}
