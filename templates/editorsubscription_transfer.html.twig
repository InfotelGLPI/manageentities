{# Transfer of a publisher subscription to another client entity
   (EditorSubscriptionWizard::renderTransfer(), confirmation: public/scripts/editorsubscription-fields.js) #}
<form method="post" action="{{ page_url }}"
      data-me-sub-transfer-form="{{ __('Transfer this subscription to the selected entity?', 'manageentities') }}">
    <input type="hidden" name="action" value="transfer">
    <input type="hidden" name="sub_id" value="{{ sub_id }}">

    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title mb-0">
                <i class="ti ti-transfer me-2"></i>{{ __('Transfer the subscription', 'manageentities') }}
            </h3>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-sm-6">
                    <label class="col-form-label fw-bold">{{ __('Publisher subscription', 'manageentities') }}</label>
                    <input type="text" class="form-control" value="{{ sub_name }}" readonly disabled>
                </div>
                <div class="col-sm-6">
                    <label class="col-form-label fw-bold">{{ __('Current entity', 'manageentities') }}</label>
                    <input type="text" class="form-control" value="{{ entity_completename }}" readonly disabled>
                </div>
                <div class="col-sm-6">
                    <label class="col-form-label fw-bold">
                        {{ __('Target entity', 'manageentities') }} <span class="text-danger">*</span>
                    </label>
                    {{ 'Entity'|itemtype_dropdown({
                        'name': 'target_entities_id',
                        'rand': rand,
                        'value': 0,
                        'condition': transfer_condition,
                    }) }}
                    <div class="form-text">
                        {{ __('The target entity must not have a publisher subscription yet.', 'manageentities') }}
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex gap-2 justify-content-between">
            <a href="{{ back_url }}" class="btn btn-outline-secondary">
                <i class="ti ti-x me-1"></i>{{ __('Cancel') }}
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="ti ti-transfer me-2"></i>{{ __('Transfer') }}
            </button>
        </div>
    </div>
</form>
