<div class="card mt-3" id="global_form_content{{ id_to_use }}"
    {% if nb_days <= 0 %}style="display:none"{% endif %}>
    <div class="card-header">
        <h3 class="card-title">
            <i class="ti ti-user-plus me-2"></i>
            {{ __('Add stakeholders', 'manageentities') }}
        </h3>
    </div>
    <div class="card-body">
        <div class="row g-3 align-items-end">

            <div class="col-sm-5">
                <label class="form-label fw-bold">
                    {{ __('User') }}
                    <span class="text-danger">*</span>
                </label>
                {{ 'User'|itemtype_dropdown({
                    'name': 'users_id_tech' ~ id_to_use,
                    'right': 'interface',
                    'rand': user_rand,
                }) }}
            </div>

            <div class="col-sm-4">
                <label class="form-label fw-bold">
                    {{ __('Affected to', 'manageentities') }}
                    <span class="text-danger">*</span>
                </label>
                <div class="d-flex align-items-center gap-2">
                    {% do call('Dropdown::showNumber', ['nb_days', {
                        'width': 100,
                        'min': 0,
                        'max': nb_days,
                        'step': nbdays_step,
                        'rand': nbdays_rand,
                    }]) %}
                    <span class="text-muted">{{ unit }}</span>
                </div>
            </div>

            <div class="col-sm-3">
                {# Handled by public/scripts/interventionstakeholder.js #}
                <button type="button" class="btn btn-primary w-100"
                        data-me-stakeholder-add
                        data-me-url="{{ ajax_url }}"
                        data-me-contractdays-id="{{ contractdays_id }}"
                        data-me-user-field="{{ user_field }}"
                        data-me-nbdays-field="{{ nbdays_field }}"
                        data-me-nbdays-step="{{ nbdays_step }}">
                    <i class="ti ti-plus me-1"></i>{{ __('Add') }}
                </button>
            </div>

        </div>
    </div>
</div>

