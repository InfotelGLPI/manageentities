{# Open tickets of the active customers: the customers entity itself and the archived
   customers are left out, as in the other provider-side overviews #}
{% set rand = random() %}

{% macro ticket_table(tickets, show_techs = false) %}
    <div class="table-responsive">
        <table class="table table-sm table-hover table-vcenter mb-0">
            <thead>
                <tr>
                    <th>{{ _n('Ticket', 'Tickets', 1) }}</th>
                    <th>{{ _n('Entity', 'Entities', 1) }}</th>
                    {% if show_techs %}
                        <th>{{ __('Assigned technician(s)', 'manageentities') }}</th>
                    {% endif %}
                    <th>{{ __('Status') }}</th>
                    <th class="text-nowrap">{{ __('Opening date') }}</th>
                    <th class="text-end text-nowrap">{{ __('Age (days)', 'manageentities') }}</th>
                </tr>
            </thead>
            <tbody>
            {% for ticket in tickets %}
                <tr>
                    <td><a href="{{ ticket.url }}">{{ ticket.name }} ({{ ticket.id }})</a></td>
                    <td>{{ ticket.entity_name }}</td>
                    {% if show_techs %}
                        <td>
                            {% for tech in ticket.techs %}
                                <span class="badge bg-blue-lt me-1"><i class="ti ti-user me-1"></i>{{ tech }}</span>
                            {% else %}
                                <span class="badge bg-yellow-lt"><i class="ti ti-user-off me-1"></i>{{ __('No technician', 'manageentities') }}</span>
                            {% endfor %}
                        </td>
                    {% endif %}
                    <td>{{ ticket.status }}</td>
                    <td class="text-nowrap">{{ ticket.date|formatted_datetime }}</td>
                    <td class="text-end"><span class="badge bg-red-lt">{{ ticket.age }}</span></td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endmacro %}

{# show_techs: the tickets are not grouped by technician, so list the assigned ones #}
{% macro stale_groups(groups, rand, prefix, empty_label, show_techs = false) %}
    {% if groups is not empty %}
        {# One badge per person: a click unfolds the overdue tickets below #}
        <div class="d-flex flex-wrap gap-2 p-3 border-bottom">
            {% for group in groups %}
                <button type="button" class="card card-link text-center border-2 flex-shrink-0 flex-grow-1 p-0"
                        style="min-width:110px"
                        data-bs-toggle="collapse" data-bs-target="#{{ prefix }}{{ rand }}_{{ group.users_id }}"
                        aria-expanded="false" aria-controls="{{ prefix }}{{ rand }}_{{ group.users_id }}">
                    <div class="card-body p-3 w-100">
                        <div class="display-6 fw-bold {{ group.users_id == 0 ? 'text-warning' : 'text-danger' }}">{{ group.tickets|length }}</div>
                        <div class="text-muted small mt-1">
                            <i class="ti {{ group.users_id == 0 ? 'ti-user-off' : 'ti-user' }} me-1"></i>{{ group.name }}
                        </div>
                    </div>
                </button>
            {% endfor %}
        </div>
        <div id="{{ prefix }}_list{{ rand }}">
            {% for group in groups %}
                <div class="collapse border-bottom" id="{{ prefix }}{{ rand }}_{{ group.users_id }}"
                     data-bs-parent="#{{ prefix }}_list{{ rand }}">
                    <div class="px-3 pt-3 d-flex align-items-center gap-2">
                        <h4 class="mb-2">
                            {{ group.name }}
                            <span class="badge bg-red-lt ms-1">{{ group.tickets|length }}</span>
                        </h4>
                        {% if group.url is defined %}
                            <a href="{{ group.url }}" class="ms-auto mb-2 small">
                                <i class="ti ti-search me-1"></i>{{ __('Open in the ticket search', 'manageentities') }}
                            </a>
                        {% endif %}
                    </div>
                    {{ _self.ticket_table(group.tickets, show_techs) }}
                </div>
            {% endfor %}
        </div>
    {% else %}
        <p class="text-muted text-center py-3 mb-0">{{ empty_label }}</p>
    {% endif %}
{% endmacro %}

<form method="post" action="{{ action_url }}" class="d-flex flex-wrap align-items-center gap-2 mt-2 mb-3">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    {# Incidents, requests or both: applies to every card and to the search links #}
    <label for="ticket_type{{ rand }}" class="form-label mb-0">{{ _n('Type', 'Types', 1) }}</label>
    <select class="form-select w-auto me-3" name="ticket_type" id="ticket_type{{ rand }}">
        {% for value, label in types %}
            <option value="{{ value }}" {{ value == type ? 'selected' : '' }}>{{ label }}</option>
        {% endfor %}
    </select>
    <label for="stale_weeks{{ rand }}" class="form-label mb-0">
        {{ __('Overdue tickets: opened for more than', 'manageentities') }}
    </label>
    <input type="number" class="form-control w-auto" name="stale_weeks" id="stale_weeks{{ rand }}"
           min="1" max="{{ max_weeks }}" value="{{ weeks }}" required>
    <span>{{ _n('week', 'weeks', weeks, 'manageentities') }}</span>
    <button type="submit" class="btn btn-primary">
        <i class="ti ti-refresh me-1"></i>{{ _x('button', 'Apply', 'manageentities') }}
    </button>
</form>

<div class="row g-3">
    <div class="col-12 col-xl-8">
        {# Open tickets per assigned technician, each badge opening the matching ticket search #}
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="ti ti-ticket me-1"></i>
                    {{ __('Open tickets by technician', 'manageentities') }}
                </h3>
                <div class="card-actions">
                    <a href="{{ total_url }}" class="badge bg-blue-lt text-decoration-none"
                       title="{{ __('Open in the ticket search', 'manageentities') }}">
                        {{ __('%s open ticket(s)', 'manageentities')|format(total) }}
                    </a>
                </div>
            </div>
            <div class="card-body">
                {% if techs is not empty %}
                    <div class="d-flex flex-wrap gap-2">
                        {% for tech in techs %}
                            <a href="{{ tech.url }}" class="card card-link text-center border-2 flex-shrink-0 flex-grow-1 p-0 text-decoration-none"
                               style="min-width:110px" title="{{ __('Open in the ticket search', 'manageentities') }}">
                                <div class="card-body p-3 w-100">
                                    <div class="display-6 fw-bold text-primary">{{ tech.count }}</div>
                                    <div class="text-muted small mt-1">
                                        <i class="ti ti-user me-1"></i>{{ tech.name }}
                                    </div>
                                </div>
                            </a>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-muted text-center mb-0">{{ __('No open ticket assigned to a technician', 'manageentities') }}</p>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-4">
        {# Open tickets no technician is assigned to #}
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="ti ti-user-off me-1"></i>
                    {{ __('Open tickets without technician', 'manageentities') }}
                </h3>
            </div>
            <div class="card-body">
                <a href="{{ unassigned_url }}" class="card card-link text-center border-2 p-0 text-decoration-none"
                   title="{{ __('Open in the ticket search', 'manageentities') }}">
                    <div class="card-body p-3 w-100">
                        <div class="display-6 fw-bold {{ unassigned > 0 ? 'text-warning' : 'text-success' }}">{{ unassigned }}</div>
                        <div class="text-muted small mt-1">{{ __('No technician', 'manageentities') }}</div>
                    </div>
                </a>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="ti ti-hourglass-high me-1"></i>
                    {{ __('Overdue tickets by technician', 'manageentities') }}
                </h3>
                <div class="card-actions">
                    <a href="{{ stale_url }}" class="badge bg-red-lt text-decoration-none"
                       title="{{ __('Open in the ticket search', 'manageentities') }}">{{ stale_total }}</a>
                </div>
            </div>
            <div class="card-body p-0">
                {{ _self.stale_groups(stale_techs, rand, 'stale_tech', __('No overdue ticket', 'manageentities')) }}
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-6">
        {# A ticket counts for the main tech lead of its customer only #}
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="ti ti-user-star me-1"></i>
                    {{ __('Overdue tickets by tech lead', 'manageentities') }}
                </h3>
                <div class="card-actions">
                    <span class="badge bg-red-lt">{{ stale_total }}</span>
                </div>
            </div>
            <div class="card-body p-0">
                {{ _self.stale_groups(stale_techleads, rand, 'stale_techlead', __('No overdue ticket', 'manageentities'), true) }}
            </div>
        </div>
    </div>

    <div class="col-12">
        {# Last follow-up written by a requester, no task added since: the customer awaits an answer #}
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="ti ti-message-question me-1"></i>
                    {{ __('Tickets whose last action is a customer follow-up', 'manageentities') }}
                </h3>
                <div class="card-actions">
                    <span class="badge {{ waiting is empty ? 'bg-green-lt' : 'bg-yellow-lt' }}">{{ waiting|length }}</span>
                </div>
            </div>
            <div class="card-body p-0">
                {% if waiting is not empty %}
                    <div class="table-responsive">
                        <table class="table table-sm table-hover table-vcenter mb-0">
                            <thead>
                                <tr>
                                    <th>{{ _n('Ticket', 'Tickets', 1) }}</th>
                                    <th>{{ _n('Entity', 'Entities', 1) }}</th>
                                    <th>{{ __('Status') }}</th>
                                    <th>{{ _n('Technician', 'Technicians', 2) }}</th>
                                    <th>{{ __('Customer follow-up', 'manageentities') }}</th>
                                    <th class="text-nowrap">{{ __('Date') }}</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for ticket in waiting %}
                                <tr>
                                    <td><a href="{{ ticket.url }}">{{ ticket.name }} ({{ ticket.id }})</a></td>
                                    <td>{{ ticket.entity_name }}</td>
                                    <td>{{ ticket.status }}</td>
                                    <td>
                                        {% if ticket.techs is not empty %}
                                            {{ ticket.techs|join(', ') }}
                                        {% else %}
                                            <span class="badge bg-yellow-lt">{{ __('No technician', 'manageentities') }}</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ ticket.followup_author }}</td>
                                    <td class="text-nowrap">{{ ticket.followup_date|formatted_datetime }}</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <p class="text-muted text-center py-3 mb-0">{{ __('No ticket awaiting an answer', 'manageentities') }}</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>
