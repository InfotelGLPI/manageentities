{% if can_add %}
    <form method="post" name="company_add_form" action="{{ form_url }}">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
        <input type="hidden" name="company_id" value="company">
        <input type="hidden" name="id" value="">
        <div class="card mb-3">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="ti ti-building-plus"></i>
                <strong>{{ add_title }}</strong>
            </div>
            <div class="card-body">
                <button type="submit" name="add_company" class="btn btn-primary">
                    <i class="ti ti-plus me-1"></i>{{ _x('button', 'Add') }}
                </button>
            </div>
        </div>
    </form>
{% endif %}

<div class="card mb-3">
    <div class="card-header d-flex align-items-center gap-2">
        <i class="ti ti-building"></i>
        <strong>{{ _n('Company', 'Companies', 2, 'manageentities') }}</strong>
    </div>
    <div class="card-body p-0">
        {% if companies|length > 0 %}
            {{ include('components/datatable.html.twig', {
                'entries': companies|map(c => {
                    'name': '<a href="' ~ c.url ~ '">' ~ c.name ~ '</a>',
                }),
                'columns': {
                    'name': _n('Company', 'Companies', 1, 'manageentities'),
                },
                'formatters':    {'name': 'raw_html'},
                'total_number':  companies|length,
                'nosort':        true,
                'nofilter':      true,
            }) }}
        {% else %}
            <div class="alert alert-info m-3">
                <i class="ti ti-info-circle me-2"></i>
                {{ __('No results found') }}
            </div>
        {% endif %}
    </div>
</div>
