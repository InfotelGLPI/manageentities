{% import "components/form/fields_macros.html.twig" as fields %}

<form name="taskcategory_form" method="post" action="{{ form_url }}">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    <input type="hidden" name="id" value="{{ item_id }}">
    <div class="card mb-3">
        <div class="card-header d-flex align-items-center gap-2">
            <i class="ti ti-list-check"></i>
            <strong>{{ title }}</strong>
        </div>
        <div class="card-body">
            <div class="row">
                {{ fields.dropdownYesNo(
                    'is_usedforcount',
                    is_usedforcount,
                    __('Use for calculation of intervention report', 'manageentities')
                ) }}
            </div>
        </div>
        {% if can_update %}
            <div class="card-footer d-flex justify-content-end">
                <button type="submit" name="update" value="1" class="btn btn-primary">
                    <i class="ti ti-device-floppy me-1"></i>{{ _x('button', 'Save') }}
                </button>
            </div>
        {% endif %}
    </div>
</form>
