{# Shown on top of a ticket task form when the contract period has no day left #}
<div class="alert alert-danger d-flex align-items-center gap-2 mb-3" role="alert">
    <i class="ti ti-ban fs-4"></i>
    <div>
        <strong>{{ __('Task addition blocked', 'manageentities') }}</strong>
        <br>
        {{ __('No days remaining on this contract period. Task addition is blocked.', 'manageentities') }}
    </div>
</div>
