{# "Prices" tab of an intervention type (CriPrice::showForCriType()) #}
<div class="table-responsive">
    <table class="table table-sm table-hover table-vcenter">
        <thead>
            <tr>
                <th>{{ contractday_label }}</th>
                <th>{{ _n('Entity', 'Entities', 1) }}</th>
                <th class="text-end">{{ price_label }}</th>
            </tr>
        </thead>
        <tbody>
            {% for row in rows %}
                <tr>
                    <td><a href="{{ row.url }}">{{ row.contractday }}</a></td>
                    <td>{{ row.entity }}</td>
                    <td class="text-end">{{ row.price }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
