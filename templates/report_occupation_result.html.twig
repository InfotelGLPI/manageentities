{# Result of the occupation report (Report::showOccupationReports()): one row per day, one
   column per technician, numbers formatted by the caller #}
<div class="card mt-3">
    <div class="card-header">
        <h3 class="card-title">
            <i class="ti ti-calendar-time me-1"></i>
            {{ __('Report concerning the occupation of the technicians', 'manageentities') }}
        </h3>
    </div>
    <div class="table-responsive">
        <table class="table table-sm table-hover table-vcenter card-table">
            <thead>
                <tr>
                    <th>{{ __('Daily schedule', 'manageentities') }}</th>
                    <th colspan="{{ technicians|length + 1 }}" class="text-center">{{ __('Technicians', 'manageentities') }}</th>
                    <th class="text-end">{{ __('Time justified', 'manageentities') }}</th>
                </tr>
                <tr>
                    <th>{{ __('Date') }}</th>
                    {% for technician in technicians %}
                        <th class="text-end">{{ technician }}</th>
                    {% endfor %}
                    <th class="text-end">{{ __('Total') }}</th>
                    <th class="text-end">{{ __('% of time justified', 'manageentities') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                    <tr>
                        <td>{{ row.date }}</td>
                        {% for time in row.times %}
                            <td class="text-end">{{ time }}</td>
                        {% endfor %}
                        <td class="text-end fw-bold">{{ row.total }}</td>
                        <td class="text-end">{{ row.total_justified }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
