{#
 # Caption shared by the two reports: one swatch per entry, matching the colour the cells
 # of the report are tinted with -- the contract states for the general follow-up, the
 # exceeding and to-invoice backgrounds for the monthly one. It replaced two tab_cadre
 # tables whose cells were wrapped every five or ten entries, so each caption was a grid
 # of fixed width that did not reflow and that Tabler no longer styles. The colour is
 # carried by a custom property and the blend itself lives in the stylesheet, so the
 # swatch follows the dark palette exactly like the rows do.
 #}
{% if entries is not empty %}
    <div class="card mb-3">
        <div class="card-header d-flex align-items-center gap-2">
            <i class="ti ti-palette" aria-hidden="true"></i>
            <strong>{{ __('Caption') }}</strong>
        </div>

        <div class="card-body d-flex flex-wrap gap-2">
            {% for entry in entries %}
                <span class="badge bg-outline-secondary d-inline-flex align-items-center gap-2">
                    <span class="manageentities-legend-swatch"
                          style="--me-state-color: {{ entry.color }}" aria-hidden="true"></span>
                    {{ entry.name }}
                </span>
            {% endfor %}
        </div>
    </div>
{% endif %}
