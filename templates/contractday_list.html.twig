<div class="card mt-3">

    <div class="card-header">
    <h3 class="card-title">
        <i class="ti ti-calendar-stats me-2"></i>
        {{ __('Periods of contract', 'manageentities') }}
        <span class="badge bg-secondary-lt ms-1">{{ entries|length }}</span>
    </h3>
    </div>

    <div class="card-body p-0">
        {% if entries|length > 0 %}
        {{ include('components/datatable.html.twig', {
            'datatable_id': 'contractday_list_' ~ rand,
            'nosort': true,
            'nofilter': true,
            'columns': columns,
            'formatters': formatters,
            'entries': entries,
            'total_number': entries|length,
            'filtered_number': entries|length,
            'table_class_style': 'table-hover table-sm',
            'showmassiveactions': can_edit,
            'massiveactionparams': massiveactionparams,
        }) }}
        {% else %}
        <div class="p-3 text-muted">{{ __('No period found', 'manageentities') }}</div>
        {% endif %}
    </div>


    {% if add_form %}
    <div class="card-footer">
        {{ include('@manageentities/contractday_add_form.html.twig', add_form) }}
    </div>
    {% endif %}
</div>
