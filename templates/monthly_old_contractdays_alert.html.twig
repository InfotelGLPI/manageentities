{# Tickets whose supplementary interventions depend on a contract period already ended #}
<div class="alert alert-warning d-flex">
    {{ __('Warning : There are supplementary interventions which depends on a prestation with a earlier end date', 'manageentities') }}
</div>
<div class="mb-3">
    {{ _n('Ticket', 'Tickets', tickets|length) }} :
    {% for ticket in tickets %}
        {# link: Ticket::getLink(), which escapes the name itself #}
        {{ ticket.link|raw }} ({{ ticket.id }})<br>
    {% endfor %}
</div>
