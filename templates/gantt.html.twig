{# The chart is built by public/scripts/gantt.js, which reads the payload back from the
 # attribute below. json_encode is declared safe for the "json" strategy only, so Twig
 # still HTML-escapes it here, in attribute context. #}
<div class="manageentities-gantt" data-me-gantt="{{ config|json_encode }}"></div>
