{# Table of the proposals in progress (PresaleWizard::getOpenProposals()), shared by the landing
 # page of the pre-sales, the form of a prospect and the pre-sales tab of the clients management.
 #
 # proposals  - rows of getOpenProposals()
 # options:
 #   action_url   - target of the Lost / Won / Delete buttons, none when empty
 #   can_purge    - offers the deletion
 #   nb_steps     - number of steps of the wizard, the progress column when given
 #   show_client  - the column of the prospect
 #   show_total   - the column of the total excluding VAT
 #}
{% macro table(proposals, options = {}) %}
    {% import '@manageentities/presale/outcome_buttons.html.twig' as outcome %}
    {% set options = {'action_url': '', 'can_purge': false, 'nb_steps': 0, 'show_client': true, 'show_total': false}|merge(options) %}
    <div class="table-responsive">
        <table class="table table-sm table-hover card-table mb-0">
            <thead>
                <tr>
                    <th>{{ __('Name') }}</th>
                    {% if options.show_client %}<th>{{ _n('Prospect', 'Prospects', 1, 'manageentities') }}</th>{% endif %}
                    <th>{{ __('Status') }}</th>
                    {% if options.nb_steps %}<th>{{ __('Progress', 'manageentities') }}</th>{% endif %}
                    {% if options.show_total %}<th class="text-end">{{ __('Total excluding VAT', 'manageentities') }}</th>{% endif %}
                    <th>{{ __('Last update') }}</th>
                    {% if options.action_url %}<th class="text-end">{{ __('Outcome of the proposal', 'manageentities') }}</th>{% endif %}
                </tr>
            </thead>
            <tbody>
            {% for proposal in proposals %}
                <tr>
                    <td><a href="{{ proposal.url }}">{{ proposal.name }}</a></td>
                    {% if options.show_client %}<td><a href="{{ proposal.client_url }}">{{ proposal.client }}</a></td>{% endif %}
                    <td>
                        <span class="badge {{ proposal.is_sent ? 'bg-blue-lt' : 'bg-secondary-lt' }}">{{ proposal.status }}</span>
                        {% if proposal.estimate_status == 1 %}
                            <a href="{{ proposal.estimate_url }}" class="badge bg-orange-lt text-decoration-none" title="{{ __('Estimate requested', 'manageentities') }}"><i class="ti ti-calculator"></i></a>
                        {% elseif proposal.estimate_status == 2 %}
                            <a href="{{ proposal.estimate_url }}" class="badge bg-green-lt text-decoration-none" title="{{ __('Estimate validated', 'manageentities') }}"><i class="ti ti-calculator"></i></a>
                        {% endif %}
                    </td>
                    {% if options.nb_steps %}<td>{{ proposal.step }} / {{ options.nb_steps }}</td>{% endif %}
                    {% if options.show_total %}<td class="text-end">{{ proposal.total_ht|formatted_number }} €</td>{% endif %}
                    <td>
                        {{ proposal.date_mod|formatted_datetime }}
                        {% if proposal.modified %}
                            <i class="ti ti-alert-triangle text-warning ms-1" title="{{ __('Modified since the last generation', 'manageentities') }}"></i>
                        {% endif %}
                    </td>
                    {% if options.action_url %}
                        <td class="text-end">{{ outcome.buttons(proposal.id, options.action_url, proposal.can_win, proposal.modified, true, 'btn-sm', options.can_purge, proposal.can_send) }}</td>
                    {% endif %}
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endmacro %}
