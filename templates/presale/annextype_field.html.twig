{# Specific fields of the annex models (PresaleAnnexType::displaySpecificTypeField) #}
{% if type == 'vat_rate' %}
   <input type="number" class="form-control" name="default_vat" value="{{ value }}" min="0" max="100" step="0.01">
{% elseif type == 'export_json' %}
   <a class="btn btn-sm btn-outline-secondary" href="{{ export_url }}">
      <i class="ti ti-file-export me-1"></i>{{ __('Export as JSON', 'manageentities') }}
   </a>
{% endif %}
