{% import '@manageentities/presale/proposals_table.html.twig' as proposals %}

{# Landing page of the pre-sales section.
 #
 # new_url        - first step of a new proposal
 # list_url       - search page of the proposals
 # clients_url    - search page of the prospects
 # estimates      - proposals whose estimate is requested from the connected user (project manager)
 # drafts         - proposals in progress: id, url, name, client, status, step, date_mod,
 #                  can_win, modified
 # action_url     - target of the Lost / Won buttons
 # can_update     - whether the user can change the proposals
 # nb_steps       - number of steps of the wizard
 # missing_entity - the customers entity is not configured
 #}

<div class="container-fluid">
    <div class="text-center mb-4">
        <h2><i class="ti ti-file-dollar me-2"></i>{{ __('Pre-sales', 'manageentities') }}</h2>
        <p class="text-muted">{{ __('Build a financial proposal for a prospect or an existing client.', 'manageentities') }}</p>
    </div>

    {% if missing_entity %}
        <div class="alert alert-warning">
            <i class="ti ti-alert-triangle me-1"></i>
            {{ __('The customers entity is not set in the configuration of the plugin: the pre-sales section cannot be used until it is.', 'manageentities') }}
        </div>
    {% else %}
        <div class="row g-4 justify-content-center mb-4">
            <div class="col-sm-6 col-lg-4">
                <a href="{{ new_url }}" class="card h-100 border-2 text-decoration-none text-reset">
                    <div class="card-body text-center py-5">
                        <i class="ti ti-file-plus text-primary" style="font-size:3rem"></i>
                        <h4 class="mt-3">{{ __('New proposal', 'manageentities') }}</h4>
                        <p class="text-muted mb-0">{{ __('For a new prospect or a prospect already known.', 'manageentities') }}</p>
                    </div>
                </a>
            </div>
            <div class="col-sm-6 col-lg-4">
                <a href="{{ list_url }}" class="card h-100 border-2 text-decoration-none text-reset">
                    <div class="card-body text-center py-5">
                        <i class="ti ti-list-search text-secondary" style="font-size:3rem"></i>
                        <h4 class="mt-3">{{ _n('Financial proposal', 'Financial proposals', 2, 'manageentities') }}</h4>
                        <p class="text-muted mb-0">{{ __('Search the proposals, archived ones included.', 'manageentities') }}</p>
                    </div>
                </a>
            </div>
            <div class="col-sm-6 col-lg-4">
                <a href="{{ clients_url }}" class="card h-100 border-2 text-decoration-none text-reset">
                    <div class="card-body text-center py-5">
                        <i class="ti ti-building-store text-secondary" style="font-size:3rem"></i>
                        <h4 class="mt-3">{{ _n('Prospect', 'Prospects', 2, 'manageentities') }}</h4>
                        <p class="text-muted mb-0">{{ __('Their details, contacts and proposals.', 'manageentities') }}</p>
                    </div>
                </a>
            </div>
        </div>
    {% endif %}

    {% if estimates is not empty %}
        <div class="card mb-3 border-warning">
            <div class="card-header">
                <h3 class="card-title"><i class="ti ti-calculator me-1"></i>{{ __('Estimates to do', 'manageentities') }}</h3>
                <span class="badge bg-orange-lt ms-2">{{ estimates|length }}</span>
            </div>
            {{ proposals.table(estimates, {'nb_steps': 0}) }}
        </div>
    {% endif %}

    {% if drafts is not empty %}
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="ti ti-pencil me-1"></i>{{ __('Proposals in progress', 'manageentities') }}</h3>
            </div>
            {{ proposals.table(drafts, {'action_url': can_update ? action_url : '', 'can_purge': can_purge, 'nb_steps': nb_steps}) }}
        </div>
    {% endif %}
</div>
