{# Frame of a step of the pre-sales wizard (PresaleWizard::renderStep()).
 #
 # steps         - {number: label}
 # step          - current step
 # last_step     - last step available in this version
 # reached       - last step saved for this proposal (0 for a new one)
 # proposal      - fields of the proposal, null for a new one
 # client_name   - name of the prospect
 # readonly      - won or lost proposal: nothing can be saved
 # form_url      - front controller the steps post to
 # step_url      - link to a step of this proposal, the step number appended
 # home_url      - landing page of the section
 # errors        - {field: message} of the last failed post
 # step_template - template of the step, included with step_vars
 #}

<div id="presale-wizard" class="container-fluid">

    <div class="d-flex align-items-center flex-wrap gap-2 mb-3">
        <a href="{{ home_url }}" class="btn btn-sm btn-ghost-secondary">
            <i class="ti ti-arrow-left me-1"></i>{{ __('Pre-sales', 'manageentities') }}
        </a>
        <h2 class="mb-0 ms-2">
            {% if proposal %}
                {{ client_name }}
                {% if proposal.reference %}<span class="badge bg-blue-lt ms-2">{{ proposal.reference }}</span>{% endif %}
            {% else %}
                {{ __('New proposal', 'manageentities') }}
            {% endif %}
        </h2>
    </div>

    {# Progress: the steps already saved are links #}
    <div class="d-flex flex-wrap gap-2 mb-4 align-items-center">
        {% for n, label in steps %}
            {% set state = n < step ? 'bg-success-lt' : (n == step ? 'bg-primary-lt' : 'bg-secondary-lt') %}
            {% if step_url and n != step and n <= reached + 1 and n <= last_step %}
                <a href="{{ step_url ~ n }}" class="badge fs-6 px-3 py-2 text-decoration-none {{ state }}">{{ n }}. {{ label }}</a>
            {% else %}
                <span class="badge fs-6 px-3 py-2 {{ state }}{{ n > last_step ? ' opacity-50' : '' }}"
                      {% if n > last_step %}title="{{ __('Available in a next version', 'manageentities') }}"{% endif %}>
                    {{ n }}. {{ label }}
                </span>
            {% endif %}
            {% if not loop.last %}
                <i class="ti ti-chevron-right text-muted"></i>
            {% endif %}
        {% endfor %}
    </div>

    {% if readonly %}
        <div class="alert alert-info">
            <i class="ti ti-lock me-1"></i>
            {{ __('This proposal is won or lost: it can no longer be modified.', 'manageentities') }}
        </div>
    {% endif %}

    {% if errors is not empty %}
        <div class="alert alert-danger">
            <ul class="mb-0">
                {% for message in errors %}
                    <li>{{ message }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <form method="post" action="{{ form_url }}" enctype="multipart/form-data" data-presale-form>
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
        <input type="hidden" name="id" value="{{ proposal.id ?? 0 }}">
        <input type="hidden" name="step" value="{{ step }}">

        <fieldset {{ readonly ? 'disabled' : '' }}>
            {% include step_template with step_vars|merge({'errors': errors}) %}
        </fieldset>

        <div class="d-flex gap-2 justify-content-end mt-3">
            {# Leaves the wizard without saving this page: the steps saved before stay in the draft #}
            <a href="{{ home_url }}" class="btn btn-ghost-secondary me-auto"
               {% if step != last_step %}data-presale-confirm="{{ __('Leave the wizard without saving this page?', 'manageentities') }}"{% endif %}>
                <i class="ti ti-x me-1"></i>{{ __('Cancel') }}
            </a>
            {% if step == last_step %}
                {# The summary has nothing to save: plain links, the actions use presale-action-form #}
                <a href="{{ step_url ~ (step - 1) }}" class="btn btn-outline-secondary">
                    <i class="ti ti-arrow-left me-1"></i>{{ __('Previous') }}
                </a>
                <a href="{{ proposal_url }}" class="btn btn-outline-primary">
                    <i class="ti ti-file-dollar me-1"></i>{{ __('Back to the proposal', 'manageentities') }}
                </a>
            {% else %}
                {% if step > 1 %}
                    {# Saves the step too, so that nothing typed is lost #}
                    <button type="submit" name="previous" value="1" class="btn btn-outline-secondary" {{ readonly ? 'disabled' : '' }}>
                        <i class="ti ti-arrow-left me-1"></i>{{ __('Previous') }}
                    </button>
                {% endif %}
                <button type="submit" name="save_step" value="1" class="btn btn-primary" {{ readonly ? 'disabled' : '' }}>
                    {{ __('Next') }}<i class="ti ti-arrow-right ms-1"></i>
                </button>
            {% endif %}
        </div>
    </form>

    {# Generate / won / lost, posted by the buttons of the last step (form attribute) #}
    {% if proposal %}
        <form method="post" action="{{ action_url }}" id="presale-action-form">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <input type="hidden" name="id" value="{{ proposal.id }}">
        </form>
    {% endif %}
</div>
