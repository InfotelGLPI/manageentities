{# Sub-form of the "Export as JSON" massive action of the annex models: a download, not an action applied to each item #}
<a class="btn btn-primary" href="{{ export_url }}">
   <i class="ti ti-download me-1"></i>{{ __('Download the JSON file', 'manageentities') }}
</a>
{% if import_url %}
   <a class="btn btn-ghost-secondary" href="{{ import_url }}">
      <i class="ti ti-file-import me-1"></i>{{ __('Import annex models', 'manageentities') }}
   </a>
{% endif %}
