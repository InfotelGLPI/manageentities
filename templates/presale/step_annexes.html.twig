{% import 'components/form/fields_macros.html.twig' as fields %}

{# Step 3 — annexes of the proposal.
 #
 # annexes            - the annexes of the proposal, in document order: id, models_id, model_name,
 #                      is_subscription, level_name, mode, is_inactive, title (label without its
 #                      number), objet, description, estimate [{type, label, days}] (regular
 #                      annexes), vat_rate, lines [{designation, quantity, unit_price}]
 # models             - {models_id: name} active annex models that can be added
 # summaries          - {models_id: {comment, objet, vat, level, price, lines}} shown on choice
 # title_format       - format of the numbered title (PresaleProposal_Annex::TITLE_FORMAT)
 # models_url         - search page of the annex models
 # can_manage_models  - whether the user can create annex models
 # estimate_status, estimate_statuses, estimate_brief, estimate_comment, pm_name, has_pm,
 # estimate_url       - estimate by the project manager (PresaleWizard::requestEstimate())
 # errors             - {field: message}
 #
 # The annexes are a list: the position of a block is its number in the document ("Annexe N"),
 # and a model can be added several times. "Add" posts the step with add_annex (the model
 # chosen in the list): the server keeps what was typed, appends the annex started from its
 # model and shows the step again. public/scripts/presale-wizard.js moves and removes the
 # blocks, renumbers them, adds the lines and shows the totals (the server recomputes them).
 #
 # Lines (PresalePricing): a quantity at a unit price excluding VAT, named days / daily rate for
 # a regular annex and quantity / price for a subscription. A cloud subscription multiplies
 # subscriptions × monthly price × months (12 when empty), the price coming from its level. The mode comes from the annex model
 # (PresaleAnnexType::getPricingMode()); data-presale-mode carries it for the column labels.
 #
 # Purpose and details keep the images of the annex model (TinyMCE drops <img> when images are
 # disabled), but upload none: an image pasted here would be a document of no item.
 #}

<style>
    [data-presale-mode] [data-presale-label] { display: none; }
    [data-presale-mode="days"] [data-presale-label="days"],
    [data-presale-mode="flat"] [data-presale-label="flat"],
    [data-presale-mode="cloud"] [data-presale-label="cloud"] { display: inline; }
    /* Months: cloud subscriptions only */
    [data-presale-mode]:not([data-presale-mode="cloud"]) [data-presale-col="months"] { display: none; }
    /* Priced lines: readable inputs and totals */
    [data-presale-lines] input.form-control,
    [data-presale-lines] [data-presale-line-total] { font-size: 1rem; }
    /* Images come from the annex models: no list of uploaded files under the editors */
    [data-presale-annex] .fileupload.only-uploaded-files { display: none; }
</style>

{% set row = {'full_width': true, 'is_horizontal': false} %}

{% macro line_row(idx, line_idx, line, level_price = null) %}
    {% set name = 'annexes[' ~ idx ~ '][lines][' ~ line_idx ~ ']' %}
    <tr data-presale-line>
        <td>
            <input type="text" class="form-control" name="{{ name }}[designation]"
                   value="{{ line.designation }}" aria-label="{{ __('Designation', 'manageentities') }}">
        </td>
        {# Cloud: price per subscription and per month, then subscriptions, then months #}
        <td style="width:11rem">
            <input type="text" inputmode="decimal" class="form-control text-end" data-presale-amount="unit_price"
                   name="{{ name }}[unit_price]" value="{{ level_price is not null ? level_price|replace({'.': ','}) : line.unit_price }}"
                   {{ level_price is not null ? 'readonly title="' ~ __('Monthly price of the subscription level', 'manageentities')|e('html_attr') ~ '"' : '' }}
                   aria-label="{{ __('Price excl. VAT', 'manageentities') }}">
        </td>
        <td style="width:9rem" data-presale-col="quantity">
            <input type="text" inputmode="decimal" class="form-control text-end" data-presale-amount="quantity"
                   name="{{ name }}[quantity]" value="{{ line.quantity }}"
                   aria-label="{{ __('Quantity', 'manageentities') }}">
        </td>
        <td style="width:8rem" data-presale-col="months">
            <input type="text" inputmode="decimal" class="form-control text-end" data-presale-amount="months"
                   name="{{ name }}[months]" value="{{ line.months ?? '' }}"
                   placeholder="12" aria-label="{{ __('Number of months', 'manageentities') }}">
        </td>
        <td style="width:9rem" class="text-end align-middle" data-presale-line-total></td>
        <td style="width:2.5rem" class="text-center align-middle">
            <button type="button" class="btn btn-sm btn-ghost-danger p-1" data-presale-action="remove-line" title="{{ __('Delete') }}">
                <i class="ti ti-x"></i>
            </button>
        </td>
    </tr>
{% endmacro %}

{# Estimate by the project manager: requested from here, made on the estimate screen #}
{% if has_pm or estimate_status > 0 %}
    <div class="card mb-3 {{ estimate_status == 1 ? 'border-warning' : (estimate_status == 2 ? 'border-success' : '') }}">
        <div class="card-header d-flex align-items-center gap-2">
            <h3 class="card-title"><i class="ti ti-calculator me-1"></i>{{ __('Estimate by the project manager', 'manageentities') }}</h3>
            <span class="badge {{ estimate_status == 2 ? 'bg-green-lt' : (estimate_status == 1 ? 'bg-orange-lt' : 'bg-secondary-lt') }}">{{ estimate_statuses[estimate_status] }}</span>
            {% if estimate_url and estimate_status > 0 %}
                <a href="{{ estimate_url }}" class="btn btn-sm btn-ghost-secondary ms-auto"><i class="ti ti-external-link me-1"></i>{{ __('Open the estimate', 'manageentities') }}</a>
            {% endif %}
        </div>
        <div class="card-body">
            {% if estimate_status == 2 and estimate_comment %}
                <div class="mb-2"><strong>{{ pm_name }} :</strong> <span style="white-space: pre-line">{{ estimate_comment }}</span></div>
            {% endif %}
            {% if estimate_status == 2 %}
                <div class="text-muted small mb-2">{{ __('Price the days of the estimate: the days of the lines of each annex must equal its total.', 'manageentities') }}</div>
            {% endif %}
            {% if has_pm %}
                <label class="col-form-label fw-bold" for="presale_estimate_brief">{{ __('Note for the project manager', 'manageentities') }}</label>
                <textarea id="presale_estimate_brief" name="estimate_brief" class="form-control" rows="3"
                          placeholder="{{ __('Context, scope, constraints...', 'manageentities') }}">{{ estimate_brief }}</textarea>
                <button type="submit" name="request_estimate" value="1" class="btn btn-outline-warning mt-2">
                    <i class="ti ti-send me-1"></i>{{ estimate_status > 0 ? __('Request the estimate again', 'manageentities') : __('Request the estimate', 'manageentities') }}
                    ({{ pm_name }})
                </button>
                <div class="form-text">{{ __('The annexes are saved first. The project manager sets the days, and can add or remove annexes.', 'manageentities') }}</div>
            {% endif %}
        </div>
    </div>
{% endif %}

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-7">
                <label class="col-form-label fw-bold" for="dropdown_add_annex_models_id">{{ __('Add an annex', 'manageentities') }}</label>
                {{ call('Dropdown::showFromArray', ['add_annex_models_id', models, {
                    'display': false,
                    'width': '100%',
                    'display_emptychoice': true,
                    'rand': '',
                }])|raw }}
            </div>
            <div class="col-md-2">
                {# Posts the step: what was typed is kept, the annex is appended (handlePost) #}
                <button type="submit" name="add_annex" value="1" class="btn btn-outline-primary w-100" {{ models is empty ? 'disabled' : '' }}>
                    <i class="ti ti-plus me-1"></i>{{ __('Add') }}
                </button>
            </div>
            <div class="col-md-3 text-md-end">
                {% if can_manage_models %}
                    <a href="{{ models_url }}" target="_blank" class="btn btn-sm btn-ghost-secondary">
                        <i class="ti ti-settings me-1"></i>{{ _n('Annex model', 'Annex models', 2, 'manageentities') }}
                    </a>
                {% endif %}
            </div>
        </div>
        <div class="form-text">
            {{ __('The annexes are numbered in the order of the list: use the arrows to change it. A model can be added several times.', 'manageentities') }}
        </div>
        {# Summary of each model, the one chosen in the list shown (public/scripts/presale-wizard.js) #}
        {% for models_id, summary in summaries %}
            <div class="border rounded p-2 mt-2 bg-light" data-presale-model-summary="{{ models_id }}" hidden>
                <div class="d-flex flex-wrap gap-2 mb-1">
                    {% if summary.level %}
                        <span class="badge bg-orange-lt"><i class="ti ti-certificate me-1"></i>{{ summary.level }}</span>
                    {% endif %}
                    <span class="badge bg-secondary-lt">{{ __('VAT', 'manageentities') }} {{ summary.vat }} %</span>
                    {% if summary.price %}
                        <span class="badge bg-blue-lt">{{ summary.price }}</span>
                    {% endif %}
                </div>
                {% if summary.comment %}<div class="small mb-1">{{ summary.comment|nl2br }}</div>{% endif %}
                {% if summary.objet %}<div class="small text-muted">{{ __('Purpose', 'manageentities') }} : {{ summary.objet }}</div>{% endif %}
                {% if summary.lines is not empty %}
                    <ul class="small mb-0 mt-1">
                        {% for line in summary.lines %}<li>{{ line }}</li>{% endfor %}
                    </ul>
                {% endif %}
            </div>
        {% endfor %}
    </div>
</div>

{% if models is empty and annexes is empty %}
    <div class="alert alert-warning">
        <i class="ti ti-alert-triangle me-1"></i>
        {{ __('No annex model is defined: create them in Setup > Dropdowns > Annex models.', 'manageentities') }}
    </div>
{% elseif annexes is empty %}
    <div class="alert alert-info">
        <i class="ti ti-info-circle me-1"></i>
        {{ __('Choose an annex model above and add it to the proposal.', 'manageentities') }}
    </div>
{% endif %}

<div data-presale-annexes data-presale-title-format="{{ title_format }}">
{% for annex in annexes %}
    {% set idx = loop.index0 %}
    {% set prefix = 'annexes[' ~ idx ~ ']' %}
    {% set key = 'annexes.' ~ idx %}
    <div class="card mb-3 border-primary" id="presale-annex-{{ idx }}" data-presale-annex data-presale-mode="{{ annex.mode }}">
        <input type="hidden" name="{{ prefix }}[id]" value="{{ annex.id }}">
        <input type="hidden" name="{{ prefix }}[models_id]" value="{{ annex.models_id }}">
        <div class="card-header d-flex align-items-center flex-wrap gap-2">
            <span class="badge bg-primary text-white fs-5" data-presale-annex-number>{{ title_format|format(idx + 1, '')|trim|trim(':')|trim }}</span>
            <span class="text-muted">{{ annex.model_name }}</span>
            {% if annex.is_subscription %}
                <span class="badge bg-orange-lt"><i class="ti ti-certificate me-1"></i>{{ annex.level_name ?: __('Publisher subscription', 'manageentities') }}</span>
            {% endif %}
            {% if annex.is_inactive %}
                <span class="badge bg-secondary-lt" title="{{ __('This model is no longer active, it stays available for this proposal.', 'manageentities') }}">{{ __('Inactive') }}</span>
            {% endif %}
            <span class="ms-auto fw-bold" data-presale-annex-total></span>
            <div class="btn-group btn-group-sm">
                <button type="button" class="btn btn-ghost-secondary" data-presale-action="move-annex" data-direction="up" title="{{ __('Move up', 'manageentities') }}">
                    <i class="ti ti-arrow-up"></i>
                </button>
                <button type="button" class="btn btn-ghost-secondary" data-presale-action="move-annex" data-direction="down" title="{{ __('Move down', 'manageentities') }}">
                    <i class="ti ti-arrow-down"></i>
                </button>
                <button type="button" class="btn btn-ghost-danger" data-presale-action="remove-annex" title="{{ __('Delete') }}"
                        data-presale-confirm="{{ __('Remove this annex from the proposal?', 'manageentities') }}">
                    <i class="ti ti-trash"></i>
                </button>
            </div>
        </div>

        <div class="card-body">
            {% if errors[key] is defined %}<div class="alert alert-danger">{{ errors[key] }}</div>{% endif %}
            <div class="row g-3">
                <div class="col-sm-8">
                    <label class="col-form-label fw-bold" for="presale_annex_title_{{ idx }}">{{ __('Title') }}</label>
                    <div class="input-group">
                        <span class="input-group-text" data-presale-annex-prefix>{{ title_format|format(idx + 1, '')|trim }}</span>
                        <input type="text" id="presale_annex_title_{{ idx }}" name="{{ prefix }}[title]" class="form-control" value="{{ annex.title }}">
                    </div>
                </div>
                <div class="col-sm-4">
                    <label class="col-form-label fw-bold" for="presale_annex_vat_{{ idx }}">{{ __('VAT rate (%)', 'manageentities') }}</label>
                    <input type="text" inputmode="decimal" id="presale_annex_vat_{{ idx }}" name="{{ prefix }}[vat_rate]"
                           class="form-control{{ errors[key ~ '.vat_rate'] is defined ? ' is-invalid' : '' }}"
                           value="{{ annex.vat_rate }}" data-presale-amount="vat_rate">
                    <div class="form-text">{{ __('0 or empty: VAT not applicable.', 'manageentities') }}</div>
                </div>

                {# Purpose and details come from the model: folded, still posted #}
                <details class="col-12" {{ errors[key ~ '.objet'] is defined ? 'open' : '' }}>
                    <summary class="fw-bold mb-2">{{ __('Purpose', 'manageentities') }}</summary>
                    {{ fields.textareaField(prefix ~ '[objet]', annex.objet, '', row|merge({
                        'enable_richtext': true,
                        'enable_images': true,
                        'plugins_to_remove': ['glpi_upload_doc'],
                        'rand': 'objet' ~ idx,
                        'no_label': true,
                    })) }}
                </details>
                {# Estimate of a regular annex, printed under the purpose ({{CHIFFRAGE}}) #}
                {% if not annex.is_subscription %}
                    <details class="col-12" {{ errors[key ~ '.estimate'] is defined or annex.estimate is not empty ? 'open' : '' }}>
                        <summary class="fw-bold mb-2">{{ __('Estimate', 'manageentities') }}</summary>
                        {% if errors[key ~ '.estimate'] is defined %}<div class="text-danger small mb-1">{{ errors[key ~ '.estimate'] }}</div>{% endif %}
                        {{ include('@manageentities/presale/estimate_table.html.twig', {
                            'prefix': prefix ~ '[estimate]',
                            'rows': annex.estimate,
                            'total': annex.estimate_total,
                        }, with_context = false) }}
                    </details>
                {% endif %}
                <details class="col-12" {{ errors[key ~ '.description'] is defined ? 'open' : '' }}>
                    <summary class="fw-bold mb-2">{{ __('Details', 'manageentities') }}</summary>
                    {{ fields.textareaField(prefix ~ '[description]', annex.description, '', row|merge({
                        'enable_richtext': true,
                        'enable_images': true,
                        'plugins_to_remove': ['glpi_upload_doc'],
                        'rand': 'description' ~ idx,
                        'no_label': true,
                    })) }}
                </details>

                <div class="col-12">
                    <div class="table-responsive">
                        <table class="table table-vcenter mb-1{{ errors[key ~ '.lines'] is defined ? ' border border-danger' : '' }}">
                            <thead>
                                <tr>
                                    <th>{{ __('Designation', 'manageentities') }}</th>
                                    <th class="text-end">
                                        <span data-presale-label="days">{{ __('Daily rate excl. VAT', 'manageentities') }}</span>
                                        <span data-presale-label="flat">{{ __('Price excl. VAT', 'manageentities') }}</span>
                                        <span data-presale-label="cloud">{{ __('Monthly price per subscription excl. VAT', 'manageentities') }}</span>
                                    </th>
                                    <th class="text-end" data-presale-col="quantity">
                                        <span data-presale-label="days">{{ __('Days', 'manageentities') }}</span>
                                        <span data-presale-label="flat">{{ __('Quantity', 'manageentities') }}</span>
                                        <span data-presale-label="cloud">{{ __('Subscriptions', 'manageentities') }}</span>
                                    </th>
                                    <th class="text-end" data-presale-col="months">{{ __('Months', 'manageentities') }}</th>
                                    <th class="text-end">{{ __('Total excl. VAT', 'manageentities') }}</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody data-presale-lines>
                                {% for line in annex.lines %}
                                    {{ _self.line_row(idx, loop.index0, line, annex.level_price) }}
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <template data-presale-line-template>
                        {{ _self.line_row(idx, '__LINE__', {'designation': '', 'quantity': '', 'unit_price': '', 'months': ''}, annex.level_price) }}
                    </template>
                    <button type="button" class="btn btn-sm btn-outline-primary" data-presale-action="add-line">
                        <i class="ti ti-plus me-1"></i>{{ __('Add a line', 'manageentities') }}
                    </button>
                    {# Shown while the days of the lines differ from the total of the estimate #}
                    {% if not annex.is_subscription %}
                        <div class="text-warning small mt-1" data-presale-days-mismatch hidden
                             data-message="{{ __('The lines total %1$s days, the estimate %2$s days: they must be equal.', 'manageentities') }}"></div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endfor %}
</div>

{% if annexes is not empty %}
    <div class="card">
        <div class="card-body d-flex justify-content-end gap-4 fw-bold" data-presale-grand-total>
            <span>{{ __('Total excl. VAT', 'manageentities') }} : <span data-presale-sum="ht">-</span></span>
            <span>{{ __('VAT', 'manageentities') }} : <span data-presale-sum="vat">-</span></span>
            <span>{{ __('Total incl. VAT', 'manageentities') }} : <span data-presale-sum="ttc">-</span></span>
        </div>
    </div>
{% endif %}
