{# "Direct helpdesk" tab of a ticket (DirectHelpdesk_Ticket::displayTabContentForItem()) #}
{% if rows is not empty %}
    <div class="table-responsive">
        <table class="table table-sm table-hover table-vcenter">
            <thead>
                <tr>
                    <th>{{ __('Title') }}</th>
                    <th>{{ __('Date') }}</th>
                    <th>{{ __('Technician') }}</th>
                    <th>{{ __('Duration') }}</th>
                    <th>{{ __('Description') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                    <tr>
                        <td>{{ row.name }}</td>
                        <td>{{ row.date }}</td>
                        <td>{{ row.technician }}</td>
                        <td>{{ row.duration }}</td>
                        <td>{{ row.comment }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% else %}
    <div class="alert alert-info">
        {{ __('No results found') }}
    </div>
{% endif %}
