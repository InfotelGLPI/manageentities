{# "Direct helpdesk" tab of a ticket (DirectHelpdesk_Ticket::displayTabContentForItem()) #}
{% if rows is not empty %}
    <div class="table-responsive">
        <table class="table table-sm table-hover table-vcenter">
            <thead>
                <tr>
                    <th>{{ __('Title') }}</th>
                    <th>{{ __('Date') }}</th>
                    <th>{{ __('Technician') }}</th>
                    <th>{{ __('Duration') }}</th>
                    <th>{{ __('Description') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                    <tr>
                        <td>{{ row.name }}</td>
                        <td>{{ row.date }}</td>
                        <td>{{ row.technician }}</td>
                        <td>{{ row.duration }}</td>
                        <td>{{ row.comment }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% else %}
    <div class="alert alert-info">
        {{ __('No results found') }}
    </div>
{% endif %}

{# Unbilled interventions of the customer, to be associated with this ticket #}
{% if unbilled is not empty %}
    <h3 class="mt-3">{{ __('Unbilled interventions of the customer', 'manageentities') }}</h3>
    <form method="post" action="{{ form_url }}">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
        <input type="hidden" name="tickets_id" value="{{ tickets_id }}">
        <div class="table-responsive">
            <table class="table table-sm table-hover table-vcenter">
                <thead>
                    <tr>
                        <th class="text-center">{{ __('Select', 'manageentities') }}</th>
                        <th>{{ __('Title') }}</th>
                        <th>{{ __('Date') }}</th>
                        <th>{{ __('Technician') }}</th>
                        <th>{{ __('Duration') }}</th>
                        <th>{{ __('Description') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in unbilled %}
                        <tr>
                            <td class="text-center">
                                <input type="checkbox" class="form-check-input" name="select[{{ row.id }}]" value="on" checked>
                            </td>
                            <td>{{ row.name }}</td>
                            <td>{{ row.date }}</td>
                            <td>{{ row.technician }}</td>
                            <td>{{ row.duration }}</td>
                            <td>{{ row.comment|nl2br }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-center p-2">
            <button type="submit" name="associate_ticket" class="btn btn-primary btn-sm">
                <i class="ti ti-link me-1"></i>{{ __('Associate with the ticket', 'manageentities') }}
            </button>
        </div>
    </form>
{% endif %}
