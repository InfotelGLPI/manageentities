{# Customer with unplanned interventions still to be billed #}
<div class="alert alert-danger d-flex align-items-center mb-2" role="alert">
    <i class="ti ti-file-euro fs-2 me-2"></i>
    <div>
        <b>{{ __('Please note that there are unbilled interventions for this customer.', 'manageentities') }}</b>
        <span class="ms-1">
            ({{ _n('%1$s intervention', '%1$s interventions', nb, 'manageentities')|format(nb) }} - {{ duration }})
        </span>
        {% if url is not empty %}
            <a href="{{ url }}" class="ms-2">{{ __('See the unbilled interventions', 'manageentities') }}</a>
        {% endif %}
    </div>
</div>
