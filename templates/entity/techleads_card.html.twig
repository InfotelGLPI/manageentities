{# Tech leads of the client: several technicians, one of them being the main one #}
{% if techleads is not empty or can_edit_techleads %}
<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="ti ti-user-star me-1"></i>
            {{ _n('Tech lead', 'Tech leads', 2, 'manageentities') }}
        </h3>
    </div>
    <div class="card-body p-0">
        {% if techleads is not empty %}
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
                <thead>
                    <tr>
                        <th>{{ __('Name') }}</th>
                        <th>{{ __('Phone') }}</th>
                        <th>{{ __('Mobile phone') }}</th>
                        <th>{{ __('Email address') }}</th>
                        <th></th>
                        {% if can_edit_techleads and is_single %}<th></th>{% endif %}
                    </tr>
                </thead>
                <tbody>
                {% for tl in techleads %}
                    <tr>
                        <td><a href="{{ tl.url }}">{{ tl.name }}</a></td>
                        <td>{{ tl.phone }}</td>
                        <td>{{ tl.mobile }}</td>
                        <td>
                            {% if tl.email %}
                                <a href="mailto:{{ tl.email }}">{{ tl.email }}</a>
                            {% endif %}
                        </td>
                        <td>
                            {% if tl.is_default %}
                                <span class="badge bg-green-lt">{{ __('Main tech lead', 'manageentities') }}</span>
                            {% elseif can_edit_techleads and is_single %}
                                <form method="post" action="{{ entity_action_url }}" class="d-inline">
                                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                    <input type="hidden" name="id" value="{{ tl.link_id }}">
                                    <button type="submit" name="techleadbydefault" class="btn btn-link btn-sm p-0">
                                        {{ __('Set as main tech lead', 'manageentities') }}
                                    </button>
                                </form>
                            {% endif %}
                        </td>
                        {% if can_edit_techleads and is_single %}
                        <td class="text-center">
                            <form method="post" action="{{ entity_action_url }}" class="d-inline">
                                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                <input type="hidden" name="id" value="{{ tl.link_id }}">
                                <button type="submit" name="deletetechlead" class="btn btn-link text-danger p-0" title="{{ __('Delete permanently') }}">
                                    <i class="ti ti-circle-x"></i>
                                </button>
                            </form>
                        </td>
                        {% endif %}
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
            <p class="text-muted text-center py-3 mb-0">{{ __('No tech lead', 'manageentities') }}</p>
        {% endif %}

        {% if can_edit_techleads and is_single %}
        <div class="card-footer">
            <form method="post" action="{{ entity_action_url }}" class="d-flex align-items-center gap-2 flex-wrap">
                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                <input type="hidden" name="entities_id" value="{{ entity_id }}">
                <div class="flex-grow-1">{{ 'User'|itemtype_dropdown({'name': 'users_id', 'right': 'own_ticket', 'entity': techlead_entities, 'used': techlead_used}) }}</div>
                <button type="submit" name="addtechlead" class="btn btn-sm btn-primary">{{ __('Add') }}</button>
            </form>
        </div>
        {% endif %}
    </div>
</div>
{% endif %}
