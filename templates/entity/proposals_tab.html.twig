{% import '@manageentities/presale/proposals_table.html.twig' as proposals %}

{# "Proposals in progress" tab of the clients management (Entity::showOpenProposals()).
 #
 # proposals  - rows of PresaleWizard::getOpenProposals()
 # badges     - [{label, count, color, icon, url}] in progress, won, lost (url empty: no link)
 # action_url - target of the Lost / Won / Delete buttons, empty without the right
 # can_purge  - offers the deletion of a proposal
 # new_url    - new proposal (for the customer when there is a single one), empty when not allowed
 # list_url   - search page of the proposals
 # subscriptions - rows of PresaleRenewal::getExpiredSubscriptions()
 # contracts  - rows of PresaleRenewal::getExpiringContracts()
 # show_subscriptions / show_contracts - the lists of renewals the user may see
 #}

<div class="card">
    <div class="card-header d-flex align-items-center gap-2">
        <h3 class="card-title"><i class="ti ti-file-dollar me-1"></i>{{ __('Proposals in progress', 'manageentities') }}</h3>
        <a href="{{ list_url }}" class="btn btn-sm btn-ghost-secondary ms-auto">
            <i class="ti ti-list-search me-1"></i>{{ _n('Financial proposal', 'Financial proposals', 2, 'manageentities') }}
        </a>
        {% if new_url %}
            <a href="{{ new_url }}" class="btn btn-sm btn-primary">
                <i class="ti ti-file-plus me-1"></i>{{ __('New proposal', 'manageentities') }}
            </a>
        {% endif %}
    </div>
    <div class="card-body d-flex flex-wrap gap-2 border-bottom">
        {% for badge in badges %}
            {% set tag = badge.url ? 'a' : 'div' %}
            <{{ tag }} {% if badge.url %}href="{{ badge.url }}" {% endif %}class="card text-center border-2 flex-shrink-0 text-decoration-none" style="min-width:110px">
                <div class="card-body p-3">
                    <div class="display-6 fw-bold text-{{ badge.color }}">{{ badge.count }}</div>
                    <div class="text-muted small mt-1"><i class="{{ badge.icon }} me-1"></i>{{ badge.label }}</div>
                </div>
            </{{ tag }}>
        {% endfor %}
        {# Renewals to propose: counts of the lists below, each one opening its list #}
        {% for renewal in [
            {'show': show_subscriptions, 'count': subscriptions|length, 'color': 'red', 'icon': 'ti ti-certificate', 'label': __('Expired subscriptions to renew', 'manageentities'), 'anchor': 'me-renewal-subscriptions'},
            {'show': show_contracts, 'count': contracts|length, 'color': 'orange', 'icon': 'ti ti-writing-sign', 'label': __('Contracts running out of remaining days', 'manageentities'), 'anchor': 'me-renewal-contracts'},
        ] %}
            {% if renewal.show %}
                <a href="#{{ renewal.anchor }}" class="card text-center border-2 flex-shrink-0 text-decoration-none" style="min-width:110px">
                    <div class="card-body p-3">
                        <div class="display-6 fw-bold text-{{ renewal.color }}">{{ renewal.count }}</div>
                        <div class="text-muted small mt-1"><i class="{{ renewal.icon }} me-1"></i>{{ renewal.label }}</div>
                    </div>
                </a>
            {% endif %}
        {% endfor %}
    </div>
    {% if proposals is empty %}
        <div class="card-body text-muted">{{ __('No proposal in progress.', 'manageentities') }}</div>
    {% else %}
        {{ proposals.table(proposals, {'action_url': action_url, 'can_purge': can_purge, 'show_total': true}) }}
    {% endif %}
</div>

{# Renewals to propose: a row leaves its list once a proposal started from it is in progress or won #}
{% if show_subscriptions %}
    <div class="card mt-3" id="me-renewal-subscriptions">
        <div class="card-header">
            <h3 class="card-title">
                <i class="ti ti-certificate me-1"></i>{{ __('Expired subscriptions to renew', 'manageentities') }}
                <span class="badge bg-red-lt ms-1">{{ subscriptions|length }}</span>
            </h3>
        </div>
        {% if subscriptions is empty %}
            <div class="card-body text-muted">{{ __('No expired subscription to renew.', 'manageentities') }}</div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-sm table-hover card-table mb-0">
                    <thead>
                        <tr>
                            <th>{{ _n('Entity', 'Entities', 1) }}</th>
                            <th>{{ __('Referenced name at the publisher', 'manageentities') }}</th>
                            <th class="text-center">{{ __('Type', 'manageentities') }}</th>
                            <th>{{ __('Subscription level', 'manageentities') }}</th>
                            <th>{{ __('End date', 'manageentities') }}</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in subscriptions %}
                            <tr>
                                <td>{{ row.entity }}</td>
                                <td>{{ row.name ?: '-' }}</td>
                                <td class="text-center">
                                    {% if row.cloud_client %}
                                        <span class="badge bg-info-lt"><i class="ti ti-cloud me-1"></i>{{ __('Cloud', 'manageentities') }}</span>
                                    {% else %}
                                        <span class="badge bg-success-lt"><i class="ti ti-certificate me-1"></i>{{ __('Editor', 'manageentities') }}</span>
                                    {% endif %}
                                </td>
                                <td>{{ row.level ?: '-' }}</td>
                                <td class="text-danger fw-bold">{{ row.end_date|formatted_date }}</td>
                                <td class="text-end">
                                    {% if row.new_url %}
                                        <a href="{{ row.new_url }}" class="btn btn-sm btn-outline-primary">
                                            <i class="ti ti-file-plus me-1"></i>{{ __('New proposal', 'manageentities') }}
                                        </a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endif %}

{% if show_contracts %}
    <div class="card mt-3" id="me-renewal-contracts">
        <div class="card-header">
            <h3 class="card-title">
                <i class="ti ti-writing-sign me-1"></i>{{ __('Contracts running out of remaining days', 'manageentities') }}
                <span class="badge bg-orange-lt ms-1">{{ contracts|length }}</span>
            </h3>
        </div>
        <div class="card-body border-bottom py-2 small text-muted">
            {{ __('The contracts of the alert mail: every open period has less than one remaining day, and the customer has no day left on its other contracts. To prepare a proposal for a new contract.', 'manageentities') }}
        </div>
        {% if contracts is empty %}
            <div class="card-body text-muted">{{ __('No contract running out of remaining days.', 'manageentities') }}</div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-sm table-hover card-table mb-0">
                    <thead>
                        <tr>
                            <th>{{ _n('Entity', 'Entities', 1) }}</th>
                            <th>{{ _n('Contract', 'Contracts', 1) }}</th>
                            <th>{{ __('Number') }}</th>
                            <th>{{ __('Start date', 'manageentities') }}</th>
                            <th>{{ __('Prestation', 'manageentities') }}</th>
                            <th class="text-end">{{ __('Remaining days', 'manageentities') }}</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in contracts %}
                            <tr>
                                <td>{{ row.entity }}</td>
                                <td><a href="{{ row.contract_url }}">{{ row.name ?: '-' }}</a></td>
                                <td>{{ row.num ?: '-' }}</td>
                                <td>{{ row.begin_date ? row.begin_date|formatted_date : '-' }}</td>
                                <td class="small">{{ row.prestations ?: '-' }}</td>
                                <td class="text-end text-danger fw-bold">{{ row.remaining_days|formatted_number }}</td>
                                <td class="text-end">
                                    {% if row.new_url %}
                                        <a href="{{ row.new_url }}" class="btn btn-sm btn-outline-primary">
                                            <i class="ti ti-file-plus me-1"></i>{{ __('New proposal', 'manageentities') }}
                                        </a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endif %}
