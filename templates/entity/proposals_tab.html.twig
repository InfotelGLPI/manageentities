{% import '@manageentities/presale/proposals_table.html.twig' as proposals %}

{# "Proposals in progress" tab of the clients management (Entity::showOpenProposals()).
 #
 # proposals  - rows of PresaleWizard::getOpenProposals()
 # badges     - [{label, count, color, icon, url}] in progress, won, lost (url empty: no link)
 # action_url - target of the Lost / Won / Delete buttons, empty without the right
 # can_purge  - offers the deletion of a proposal
 # new_url    - new proposal (for the customer when there is a single one), empty when not allowed
 # list_url   - search page of the proposals
 #}

<div class="card">
    <div class="card-header d-flex align-items-center gap-2">
        <h3 class="card-title"><i class="ti ti-file-dollar me-1"></i>{{ __('Proposals in progress', 'manageentities') }}</h3>
        <a href="{{ list_url }}" class="btn btn-sm btn-ghost-secondary ms-auto">
            <i class="ti ti-list-search me-1"></i>{{ _n('Financial proposal', 'Financial proposals', 2, 'manageentities') }}
        </a>
        {% if new_url %}
            <a href="{{ new_url }}" class="btn btn-sm btn-primary">
                <i class="ti ti-file-plus me-1"></i>{{ __('New proposal', 'manageentities') }}
            </a>
        {% endif %}
    </div>
    <div class="card-body d-flex flex-wrap gap-2 border-bottom">
        {% for badge in badges %}
            {% set tag = badge.url ? 'a' : 'div' %}
            <{{ tag }} {% if badge.url %}href="{{ badge.url }}" {% endif %}class="card text-center border-2 flex-shrink-0 text-decoration-none" style="min-width:110px">
                <div class="card-body p-3">
                    <div class="display-6 fw-bold text-{{ badge.color }}">{{ badge.count }}</div>
                    <div class="text-muted small mt-1"><i class="{{ badge.icon }} me-1"></i>{{ badge.label }}</div>
                </div>
            </{{ tag }}>
        {% endfor %}
    </div>
    {% if proposals is empty %}
        <div class="card-body text-muted">{{ __('No proposal in progress.', 'manageentities') }}</div>
    {% else %}
        {{ proposals.table(proposals, {'action_url': action_url, 'can_purge': can_purge, 'show_total': true}) }}
    {% endif %}
</div>
