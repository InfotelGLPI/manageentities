{# Search and badge filters: public/scripts/editorsubscription-tab.js
 # use_presale - offers the "expired without any proposal" badge (row.proposal is only known then)
 #}
<div class="card mt-3" data-me-sub-tab>
    <div class="card-header d-flex align-items-center gap-2">
        <h3 class="card-title">
            <i class="ti ti-certificate me-2"></i>
            {{ __('Publisher subscriptions', 'manageentities') }}
            {% set total_count   = rows|length %}
            {% set expired_count = rows|filter(r => r.end_date_expired)|length %}
            {% if total_count > 0 %}
                <span class="badge bg-secondary-lt ms-2">{{ total_count }}</span>
            {% endif %}
            {% if expired_count > 0 %}
                <span class="badge bg-danger-lt ms-1" title="{{ __('Expired subscriptions', 'manageentities') }}">
                    <i class="ti ti-clock-exclamation me-1"></i>{{ expired_count }}
                </span>
            {% endif %}
        </h3>
        <div class="card-options ms-auto d-flex gap-2">
            <div class="input-group input-group-sm" style="width: 220px;">
                <span class="input-group-text"><i class="ti ti-search"></i></span>
                <input type="text" class="form-control" placeholder="{{ __('Search') }}" data-me-sub-search>
            </div>
            <a href="{{ export_url }}" class="btn btn-sm btn-outline-secondary"
               data-me-sub-export="{{ {'all': export_url, 'expired': export_url ~ '&sub_expired=1'}|json_encode }}">
                <i class="ti ti-table-export me-1"></i>{{ __('Export CSV', 'manageentities') }}
            </a>
            {% if can_edit %}
            <a href="{{ wizard_url }}" class="btn btn-sm btn-outline-success">
                <i class="ti ti-plus me-1"></i>{{ __('Create subscription', 'manageentities') }}
            </a>
            {% endif %}
        </div>
    </div>

    {# Badges as in the proposals tab: a click filters the list on them, a second one clears it #}
    {% if rows|length > 0 %}
    {% set current_rows = rows|filter(r => not r.end_date_expired) %}
    {% set expired_rows = rows|filter(r => r.end_date_expired) %}
    {% set badges = [
        {'key': 'current', 'count': current_rows|length, 'color': 'green', 'icon': 'ti ti-certificate', 'label': __('Subscriptions in progress', 'manageentities')},
        {'key': 'onpremise', 'count': current_rows|filter(r => not r.cloud_client)|length, 'color': 'teal', 'icon': 'ti ti-server', 'label': __('On-premise subscriptions in progress', 'manageentities')},
        {'key': 'cloud', 'count': current_rows|filter(r => r.cloud_client)|length, 'color': 'cyan', 'icon': 'ti ti-cloud', 'label': __('Cloud subscriptions in progress', 'manageentities')},
        {'key': 'expired', 'count': expired_rows|length, 'color': 'red', 'icon': 'ti ti-clock-exclamation', 'label': __('Expired subscriptions', 'manageentities')},
    ] %}
    {% if use_presale %}
        {% set badges = badges|merge([
            {'key': 'noproposal', 'count': expired_rows|filter(r => not r.proposal)|length, 'color': 'orange', 'icon': 'ti ti-file-off', 'label': __('Expired subscriptions without any proposal', 'manageentities')},
        ]) %}
    {% endif %}
    <div class="card-body d-flex flex-wrap gap-2 border-bottom">
        {% for badge in badges %}
            <button type="button" class="card text-center border-2 flex-shrink-0" style="min-width:110px"
                    data-me-sub-badge="{{ badge.key }}" aria-pressed="false">
                <div class="card-body p-3">
                    <div class="display-6 fw-bold text-{{ badge.color }}">{{ badge.count }}</div>
                    <div class="text-muted small mt-1"><i class="{{ badge.icon }} me-1"></i>{{ badge.label }}</div>
                </div>
            </button>
        {% endfor %}
    </div>
    {% endif %}

    <div class="card-body p-0">
        {% if rows|length > 0 %}
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0">
                <thead>
                    <tr>
                        <th>{{ _n('Entity', 'Entities', 1) }}</th>
                        <th>{{ __('Publisher customer account ID', 'manageentities') }}</th>
                        <th>{{ __('Referenced name at the publisher', 'manageentities') }}</th>
                        <th>{{ __('Last intervention', 'manageentities') }}</th>
                        <th class="text-center">{{ __('Type', 'manageentities') }}</th>
                        <th>{{ __('Subscription level', 'manageentities') }}</th>
                        <th>{{ __('Start date', 'manageentities') }}</th>
                        <th>{{ __('End date', 'manageentities') }} <i class="ti ti-sort-ascending ms-1 text-muted" title="{{ __('Sorted by oldest end date first', 'manageentities') }}"></i></th>
                        {% if can_edit or rows|filter(r => r.proposal_url or r.proposal)|length > 0 %}<th></th>{% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                    {% set filters = row.end_date_expired
                        ? ['expired']|merge(use_presale and not row.proposal ? ['noproposal'] : [])
                        : ['current', row.cloud_client ? 'cloud' : 'onpremise'] %}
                    <tr data-me-sub-filters="{{ filters|join(' ') }}">
                        <td>{{ row.entity_completename ?: '—' }}</td>
                        <td>{{ row.customer_account_id ?: '—' }}</td>
                        <td>{{ row.name ?: '—' }}</td>
                        <td>{{ row.last_intervention ? row.last_intervention|date('d/m/Y') : '—' }}</td>
                        <td class="text-center">
                            {% if row.cloud_client %}
                                <span class="badge bg-info-lt"><i class="ti ti-cloud me-1"></i>{{ __('Cloud', 'manageentities') }}</span>
                            {% else %}
                                <span class="badge bg-success-lt"><i class="ti ti-certificate me-1"></i>{{ __('Editor', 'manageentities') }}</span>
                            {% endif %}
                        </td>
                        <td>{{ row.level_name ?: '—' }}</td>
                        <td>{{ row.begin_date ? row.begin_date|date('d/m/Y') : '—' }}</td>
                        <td class="{% if row.end_date_expired %}text-danger fw-bold{% endif %}">
                            {{ row.end_date ? row.end_date|date('d/m/Y') : '—' }}
                            {% if row.end_date_expired %}<i class="ti ti-alert-circle ms-1"></i>{% endif %}
                        </td>
                        {% if can_edit or rows|filter(r => r.proposal_url or r.proposal)|length > 0 %}
                        <td class="text-end text-nowrap">
                            {% if row.proposal %}
                                <a href="{{ row.proposal.url }}" class="btn btn-sm btn-outline-info"
                                   title="{{ __('Proposal created', 'manageentities') }}">
                                    <i class="ti ti-file-dollar me-1"></i>{{ row.proposal.reference }}
                                    <span class="badge bg-info-lt ms-1">{{ row.proposal.status }}</span>
                                </a>
                            {% endif %}
                            {% if row.proposal_url %}
                                <a href="{{ row.proposal_url }}" class="btn btn-sm btn-outline-success">
                                    <i class="ti ti-file-plus me-1"></i>{{ __('New proposal', 'manageentities') }}
                                </a>
                            {% endif %}
                            {% if can_edit %}
                            <a href="{{ wizard_url }}?entities_id={{ row.entities_id }}"
                               class="btn btn-sm btn-outline-primary">
                                <i class="ti ti-pencil me-1"></i>{{ __('Edit') }}
                            </a>
                            {% endif %}
                        </td>
                        {% endif %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="p-3 text-muted">
            <i class="ti ti-info-circle me-1"></i>
            {{ __('No publisher subscription recorded for this entity.', 'manageentities') }}
        </div>
        {% endif %}
    </div>
</div>

