<div class="card mt-3">
    <div class="card-header">
        <h3 class="card-title">
            <i class="ti ti-file-euro me-2"></i>
            {{ __('Unplanned interventions', 'manageentities') }}
        </h3>
    </div>
    <div class="card-body">

        {# Alerts first: they are the reason this tab exists. #}
        <div class="row g-3 mb-4">

            {# Alert 1: customers archived while interventions were still unbilled #}
            <div class="col-12 col-lg-6">
                {% if archived|length > 0 %}
                <div class="alert alert-danger d-flex align-items-start gap-2 mb-0 h-100" role="alert">
                    <i class="ti ti-archive-off flex-shrink-0 mt-1"></i>
                    <div class="w-100">
                        <strong>{{ __('Archived clients with unbilled hours:', 'manageentities') }}</strong>
                        <ul class="mb-0 mt-1">
                            {% for row in archived %}
                                <li>
                                    <a href="{{ row.url }}">{{ row.name }}</a>
                                    <span class="badge bg-outline-danger ms-1">
                                        {{ row.hours }} {{ _n('Hour', 'Hours', 2)|lower }}
                                    </span>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
                {% else %}
                <div class="alert alert-success d-flex align-items-center gap-2 mb-0 h-100" role="alert">
                    <i class="ti ti-circle-check flex-shrink-0"></i>
                    {{ __('No archived client with unbilled hours.', 'manageentities') }}
                </div>
                {% endif %}
            </div>

            {# Alert 2: interventions left unbilled for more than `months` months #}
            <div class="col-12 col-lg-6">
                {% if stale|length > 0 %}
                <div class="alert alert-warning d-flex align-items-start gap-2 mb-0 h-100" role="alert">
                    <i class="ti ti-clock-exclamation flex-shrink-0 mt-1"></i>
                    <div class="w-100">
                        <strong>
                            {{ __('Clients with hours left unbilled for more than %d months:', 'manageentities')|format(months) }}
                        </strong>
                        <ul class="mb-0 mt-1">
                            {% for row in stale %}
                                <li>
                                    <a href="{{ row.url }}">{{ row.name }}</a>
                                    <span class="badge bg-outline-warning ms-1">
                                        {{ row.hours }} {{ _n('Hour', 'Hours', 2)|lower }}
                                    </span>
                                    <span class="text-muted small ms-1">
                                        {{ __('since', 'manageentities') }} {{ row.oldest }}
                                    </span>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
                {% else %}
                <div class="alert alert-success d-flex align-items-center gap-2 mb-0 h-100" role="alert">
                    <i class="ti ti-circle-check flex-shrink-0"></i>
                    {{ __('No hours left unbilled for more than %d months.', 'manageentities')|format(months) }}
                </div>
                {% endif %}
            </div>

        </div>

        {# Main table: active clients holding a contract with ongoing services #}
        <h4 class="text-muted mb-3 fs-5">
            <i class="ti ti-clock-dollar me-1"></i>
            {{ __('Unbilled hours by client with an ongoing contract', 'manageentities') }}
        </h4>

        {% if rows|length > 0 %}
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>{{ _n('Client', 'Clients', 1, 'manageentities') }}</th>
                        <th class="text-end">{{ _n('Intervention', 'Interventions', 2, 'manageentities') }}</th>
                        <th class="text-end">{{ __('Unbilled hours', 'manageentities') }}</th>
                        <th>{{ __('Oldest intervention', 'manageentities') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                    <tr>
                        <td><a href="{{ row.url }}">{{ row.name }}</a></td>
                        <td class="text-end">{{ row.nb }}</td>
                        <td class="text-end fw-bold">{{ row.hours }}</td>
                        <td>
                            {{ row.oldest }}
                            {% if row.is_stale %}
                                <span class="badge bg-outline-warning ms-1">
                                    <i class="ti ti-alert-triangle me-1"></i>
                                    {{ __('More than %d months', 'manageentities')|format(months) }}
                                </span>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td>{{ __('Total') }}</td>
                        <td class="text-end">{{ total_nb }}</td>
                        <td class="text-end">{{ total_hours }}</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
        {% else %}
        <p class="text-muted">{{ __('No unbilled intervention for a client with an ongoing contract.', 'manageentities') }}</p>
        {% endif %}

    </div>
</div>
