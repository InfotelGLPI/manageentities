{# "Unbilled interventions" tab of the helpdesk interface (Entity::TAB_HELPDESK_UNBILLED): the
   gauges above the list of the unbilled interventions, from DirectHelpdesk::getDashboardData()
   and DirectHelpdesk_Ticket::getTicketSelectData().
 #
 # directhelpdesk_gauges - gauges, null when there is none to draw
 # directhelpdesk_select - list of the unbilled interventions, null when there is none
 #}
<div class="card">
    <div class="card-body">
        {% if directhelpdesk_gauges is not null %}
            {{ include('@manageentities/directhelpdesk_dashboard.html.twig', directhelpdesk_gauges|merge({'col_class': 'col-12 col-md-6 col-xxl-4'}), with_context = false) }}
        {% endif %}
        {% if directhelpdesk_select is not null %}
            {{ include('@manageentities/entity/directhelpdesk_ticket_select.html.twig', directhelpdesk_select, with_context = false) }}
        {% else %}
            <div class="text-muted">{{ __('No unbilled intervention', 'manageentities') }}</div>
        {% endif %}
    </div>
</div>
