{# "References" tab (Entity::showReferences()): the clients with a signed contract, grouped by
   year of first signature, with their logos.
 #
 # years      - Entity::getReferences(): {year: [{name, signature, town, country, website,
 #              website_is_url, sales, logos}]}
 # export_url - CSV export of all the references, &year= for one year
 #}
{% if years is not empty %}
    <div class="d-flex justify-content-end mb-3">
        <a href="{{ export_url }}" class="btn btn-sm btn-outline-secondary">
            <i class="ti ti-file-export me-1"></i>{{ __('Export all the references', 'manageentities') }}
        </a>
    </div>
    {% for year, clients in years %}
        <div class="card mb-3">
            <div class="card-header">
                <h3 class="card-title">
                    {{ year }}
                    <span class="badge bg-blue-lt ms-2">{{ clients|length }}</span>
                </h3>
                <div class="card-actions">
                    <a href="{{ export_url ~ '&year=' ~ year }}" class="btn btn-sm btn-ghost-secondary">
                        <i class="ti ti-file-export me-1"></i>{{ __('Export') }}
                    </a>
                </div>
            </div>
            <div class="card-body">
                <div class="row row-cards">
                    {% for client in clients %}
                        <div class="col-12 col-md-6 col-xl-4">
                            <div class="card card-sm h-100">
                                <div class="card-body d-flex align-items-center gap-3">
                                    {% for logo_id in client.logos %}
                                        {# Same bounds as the summary card (customer_summary.html.twig), ratio kept #}
                                        <img alt="{{ __('Picture') }}" class="border rounded p-2"
                                             style="max-height: 110px; max-width: 220px;"
                                             src="{{ path('front/document.send.php?docid=' ~ logo_id) }}">
                                    {% endfor %}
                                    <div class="min-w-0">
                                        <div class="fw-bold">{{ client.name }}</div>
                                        <div class="text-muted small">
                                            <i class="ti ti-writing-sign me-1"></i>{{ client.signature|formatted_date }}
                                        </div>
                                        {% set place = [client.town, client.country]|filter(v => v)|join(', ') %}
                                        {% if place %}
                                            <div class="text-muted small"><i class="ti ti-map-pin me-1"></i>{{ place }}</div>
                                        {% endif %}
                                        {% if client.sales %}
                                            <div class="text-muted small"><i class="ti ti-briefcase me-1"></i>{{ client.sales }}</div>
                                        {% endif %}
                                        {% if client.website %}
                                            <div class="small text-truncate">
                                                <i class="ti ti-world me-1"></i>
                                                {% if client.website_is_url %}
                                                    <a href="{{ client.website }}" target="_blank" rel="noopener noreferrer">{{ client.website }}</a>
                                                {% else %}
                                                    {{ client.website }}
                                                {% endif %}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    {% endfor %}
{% else %}
    <div class="alert alert-info">{{ __('No results found') }}</div>
{% endif %}
