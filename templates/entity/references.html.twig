{# "References" tab (Entity::showReferences()): the clients with a signed contract, grouped by
   year of first signature, with their logos #}
{% if years is not empty %}
    {% for year, clients in years %}
        <div class="card mb-3">
            <div class="card-header">
                <h3 class="card-title">{{ year }}</h3>
                <div class="card-actions">
                    <span class="badge bg-blue-lt">{{ clients|length }}</span>
                </div>
            </div>
            <div class="card-body">
                <div class="row row-cards">
                    {% for client in clients %}
                        <div class="col-12 col-md-6">
                            <div class="d-flex align-items-center gap-3">
                                <span class="fw-bold">{{ client.name }}</span>
                                {% for logo_id in client.logos %}
                                    <img height="50" alt="{{ __('Picture') }}"
                                         src="{{ path('front/document.send.php?docid=' ~ logo_id) }}">
                                {% endfor %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    {% endfor %}
{% else %}
    <div class="alert alert-info">{{ __('No results found') }}</div>
{% endif %}

{% if debug is not empty %}
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">{{ __('DEBUG') }}</h3>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover table-vcenter card-table">
                <thead>
                    <tr>
                        <th>{{ _n('Entity', 'Entities', 1) }}</th>
                        <th>{{ __('Date of signature', 'manageentities') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for client in debug %}
                        <tr>
                            <td>{{ client.name }}</td>
                            <td>{{ client.signature }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endif %}
