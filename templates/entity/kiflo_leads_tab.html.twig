{# "Kiflo leads" tab of the clients management (KifloLead::showLeadsTab()).
 #
 # leads      - rows of KifloLead::getLeads(), with status_label and status_color
 # badges     - [{label, count, color}] leads by status, of the leads still in Kiflo
 # all        - whether the closed leads (refused, converted, abandoned) are listed too
 # last_sync  - date of the last successful synchronization, null if none
 # last_error - error of the last synchronization, empty when it succeeded
 # filter_url - page of the clients management, target of the open / all switch
 # sync_url   - target of the "Synchronize now" button, empty without the right
 #}

<div class="card">
    <div class="card-header d-flex align-items-center flex-wrap gap-2">
        <h3 class="card-title"><i class="ti ti-target-arrow me-1"></i>{{ _n('Kiflo lead', 'Kiflo leads', 2, 'manageentities') }}</h3>
        <span class="text-muted small ms-2">
            {{ __('Last synchronization', 'manageentities') }} :
            {{ last_sync ? last_sync|formatted_datetime : '-' }}
        </span>
        <form method="post" action="{{ filter_url }}" class="ms-auto">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <input type="hidden" name="kiflo_all" value="{{ all ? 0 : 1 }}">
            <button type="submit" class="btn btn-sm btn-ghost-secondary">
                <i class="ti {{ all ? 'ti-filter' : 'ti-list' }} me-1"></i>
                {{ all ? __('Open leads only', 'manageentities') : __('Show closed leads', 'manageentities') }}
            </button>
        </form>
        {% if sync_url %}
            <form method="post" action="{{ sync_url }}">
                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                <button type="submit" name="kiflo_sync" class="btn btn-sm btn-outline-secondary">
                    <i class="ti ti-refresh me-1"></i>{{ __('Synchronize now', 'manageentities') }}
                </button>
            </form>
        {% endif %}
    </div>

    {% if last_error %}
        <div class="alert alert-danger m-3 mb-0">
            <i class="ti ti-alert-triangle me-1"></i>{{ last_error }}
        </div>
    {% endif %}

    {% if badges is not empty %}
        <div class="card-body d-flex flex-wrap gap-2 border-bottom">
            {% for badge in badges %}
                <div class="card text-center border-2 flex-shrink-0" style="min-width:110px">
                    <div class="card-body p-3">
                        <div class="display-6 fw-bold text-{{ badge.color }}">{{ badge.count }}</div>
                        <div class="text-muted small mt-1">{{ badge.label }}</div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {% if leads is not empty %}
        <div class="table-responsive">
            <table class="table table-sm table-hover card-table mb-0">
                <thead>
                    <tr>
                        <th>{{ __('Company', 'manageentities') }}</th>
                        <th>{{ _n('Contact', 'Contacts', 1) }}</th>
                        <th>{{ __('Status') }}</th>
                        <th>{{ __('Origin', 'manageentities') }}</th>
                        <th>{{ __('Owner at the publisher', 'manageentities') }}</th>
                        <th>{{ __('Creation date') }}</th>
                        <th>{{ __('Deadline', 'manageentities') }}</th>
                    </tr>
                </thead>
                <tbody>
                {% for lead in leads %}
                    <tr>
                        <td>
                            <a href="#" class="fw-bold" data-bs-toggle="modal" data-bs-target="#kiflo_lead_{{ lead.id }}">{{ lead.name }}</a>
                            {% if lead.comment %}
                                <i class="ti ti-message-circle text-muted ms-1" title="{{ __('Description', 'manageentities') }}"></i>
                            {% endif %}
                            {% if lead.customer_name %}
                                <div class="text-muted small"><i class="ti ti-building me-1"></i>{{ lead.customer_name }}</div>
                            {% endif %}
                        </td>
                        <td>
                            {{ lead.contact_name ?? '' }}
                            {% if lead.email %}
                                <div class="small"><a href="mailto:{{ lead.email }}">{{ lead.email }}</a></div>
                            {% endif %}
                            {% if lead.phone %}
                                <div class="small text-muted">{{ lead.phone }}</div>
                            {% endif %}
                        </td>
                        <td><span class="badge bg-{{ lead.status_color }}-lt">{{ lead.status_label }}</span></td>
                        <td>{{ lead.origin ?? '' }}</td>
                        <td>
                            {{ lead.owner_name ?? '' }}
                            {% if lead.owner_email %}
                                <div class="small"><a href="mailto:{{ lead.owner_email }}">{{ lead.owner_email }}</a></div>
                            {% endif %}
                        </td>
                        <td>{{ lead.date_kiflo ? lead.date_kiflo|formatted_date : '' }}</td>
                        <td>{{ lead.deadline ? lead.deadline|formatted_date : '' }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        {# Detail of each lead, opened by its company name #}
        {% for lead in leads %}
            <div class="modal fade" id="kiflo_lead_{{ lead.id }}" tabindex="-1" aria-labelledby="kiflo_lead_title_{{ lead.id }}" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="kiflo_lead_title_{{ lead.id }}">
                                <i class="ti ti-target-arrow me-1"></i>{{ lead.name }}
                                <span class="badge bg-{{ lead.status_color }}-lt ms-2">{{ lead.status_label }}</span>
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ __('Close') }}"></button>
                        </div>
                        <div class="modal-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-4">{{ _n('Contact', 'Contacts', 1) }}</dt>
                                <dd class="col-sm-8">{{ lead.contact_name ?? '-' }}</dd>

                                <dt class="col-sm-4">{{ _n('Email', 'Emails', 1) }}</dt>
                                <dd class="col-sm-8">
                                    {% if lead.email %}<a href="mailto:{{ lead.email }}">{{ lead.email }}</a>{% else %}-{% endif %}
                                </dd>

                                <dt class="col-sm-4">{{ _n('Phone', 'Phones', 1) }}</dt>
                                <dd class="col-sm-8">{{ lead.phone ?? '-' }}</dd>

                                <dt class="col-sm-4">{{ __('Origin', 'manageentities') }}</dt>
                                <dd class="col-sm-8">{{ lead.origin ?? '-' }}</dd>

                                <dt class="col-sm-4">{{ __('Owner at the publisher', 'manageentities') }}</dt>
                                <dd class="col-sm-8">
                                    {{ lead.owner_name ?? '-' }}
                                    {% if lead.owner_email %}<br><a href="mailto:{{ lead.owner_email }}">{{ lead.owner_email }}</a>{% endif %}
                                </dd>

                                {% if lead.partner_name %}
                                    <dt class="col-sm-4">{{ __('Partner', 'manageentities') }}</dt>
                                    <dd class="col-sm-8">{{ lead.partner_name }}</dd>
                                {% endif %}
                                {% if lead.deal_name %}
                                    <dt class="col-sm-4">{{ __('Deal', 'manageentities') }}</dt>
                                    <dd class="col-sm-8">{{ lead.deal_name }}</dd>
                                {% endif %}
                                {% if lead.customer_name %}
                                    <dt class="col-sm-4">{{ _n('Client', 'Clients', 1, 'manageentities') }}</dt>
                                    <dd class="col-sm-8">{{ lead.customer_name }}</dd>
                                {% endif %}

                                <dt class="col-sm-4">{{ __('Creation date') }}</dt>
                                <dd class="col-sm-8">{{ lead.date_kiflo ? lead.date_kiflo|formatted_datetime : '-' }}</dd>

                                <dt class="col-sm-4">{{ __('Deadline', 'manageentities') }}</dt>
                                <dd class="col-sm-8">{{ lead.deadline ? lead.deadline|formatted_date : '-' }}</dd>

                                {% if lead.accepted_date %}
                                    <dt class="col-sm-4">{{ __('Accepted on', 'manageentities') }}</dt>
                                    <dd class="col-sm-8">{{ lead.accepted_date|formatted_datetime }}</dd>
                                {% endif %}

                                {% for key, value in lead.extra_properties %}
                                    <dt class="col-sm-4">{{ key }}</dt>
                                    <dd class="col-sm-8">{{ value }}</dd>
                                {% endfor %}

                                <dt class="col-sm-4 text-muted small">{{ __('Kiflo ID', 'manageentities') }}</dt>
                                <dd class="col-sm-8 text-muted small">{{ lead.kiflo_id }}</dd>
                            </dl>

                            <h6 class="mt-3"><i class="ti ti-message-circle me-1"></i>{{ __('Description', 'manageentities') }}</h6>
                            {% if lead.comment %}
                                {# Free text typed in Kiflo: escaped, line breaks kept #}
                                <div class="border rounded p-2 bg-light" style="white-space: pre-wrap">{{ lead.comment }}</div>
                            {% else %}
                                <p class="text-muted mb-0">{{ __('No description', 'manageentities') }}</p>
                            {% endif %}
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ __('Close') }}</button>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    {% else %}
        <p class="text-muted text-center py-3 mb-0">
            {{ last_sync ? __('No lead', 'manageentities') : __('Not synchronized yet', 'manageentities') }}
        </p>
    {% endif %}
</div>
