{# "General follow-up" tab of the helpdesk interface: current contracts on the left, unbilled
   direct helpdesk interventions (gauge above the table) on the right. The panel contents are
   rendered by Followup::showFollowUp() and DirectHelpdesk, captured by the caller. #}
<div class="row g-3">
    <div class="col-12 {{ directhelpdesk_html is not empty ? 'col-md-6' }}">
        <div class="card h-100">
            <div class="card-header" style="background-color: var(--tblr-primary-fg);">
                <h4 class="mb-3">{{ __('Current contracts', 'manageentities') }}</h4>
            </div>
            <div class="card-body">
                {{ followup_html|raw }}
            </div>
        </div>
    </div>
    {% if directhelpdesk_html is not empty %}
        <div class="col-12 col-md-6">
            <div class="card h-100">
                <div class="card-header" style="background-color: var(--tblr-primary-fg);">
                    <h4 class="mb-3">{{ directhelpdesk_title }}</h4>
                </div>
                <div class="card-body">
                    {{ directhelpdesk_html|raw }}
                </div>
            </div>
        </div>
    {% endif %}
</div>
