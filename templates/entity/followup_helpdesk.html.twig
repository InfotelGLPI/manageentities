{# "Contractual follow-up" tab of the helpdesk interface: the current contracts, from the data
   of Followup::getFollowUpReportData(). The unbilled interventions have their own tab
   (unbilled_helpdesk.html.twig). #}
<div class="card">
    <div class="card-header" style="background-color: var(--tblr-secondary-fg);">
        <h4 class="mb-3">{{ __('Current contracts', 'manageentities') }}</h4>
    </div>
    <div class="card-body">
        {% if followup is not null %}
            {{ include('@manageentities/followup_report.html.twig', followup, with_context = false) }}
        {% else %}
            <div class="center b">{{ __('No results found') }}</div>
        {% endif %}
    </div>
</div>
