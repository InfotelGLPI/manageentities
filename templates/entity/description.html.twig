{% import 'components/form/basic_inputs_macros.html.twig' as _inputs %}

<div class="row g-3 mt-1">

    {# ── Top — administrative data and logo, one card per entity ── #}
    <div class="col-12">

        {% for ent in entities_data %}
        <div class="card {% if not loop.first %}mt-3{% endif %}">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="ti ti-building me-1"></i>
                    {{ __('Data administrative', 'manageentities') }}
                    {% if not is_single %}
                        <span class="text-muted small ms-2">— {{ ent.entity_name }}</span>
                    {% endif %}
                </h3>
            </div>
            <div class="card-body">

                <div class="row g-4">
                <div class="col-12 col-lg-8">
                {# Entity fields #}
                <form method="post" action="{{ entity_form_url }}">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                    <input type="hidden" name="entities_id" value="{{ ent.entity_id }}">

                    <dl class="row mb-0">

                        {# Editable: labels above the fields, as these; read-only: labels on the left #}
                        <dt class="{{ ent.can_update ? 'col-12 text-muted small fw-semibold mb-1' : 'col-sm-3 text-sm-end text-muted small fw-semibold col-form-label py-1' }}">{{ __('Name') }}</dt>
                        <dd class="{{ ent.can_update ? 'col-12 mb-0' : 'col-sm-9 col-form-label py-1' }}">
                            {% if ent.is_root_entity %}
                                {{ __('Root entity') }}
                            {% else %}
                                <strong>{{ ent.entity_name }}</strong>
                                <span class="text-muted small ms-1">({{ ent.entity_completename }})</span>
                            {% endif %}
                        </dd>

                        {% if ent.can_update %}
                    </dl>
                    {# Edited in place: the GLPI entity itself (front/entity.form.php) #}
                    <div class="row g-2 mt-1">
                        {% for field in [
                            {'name': 'phonenumber', 'label': __('Phone'), 'value': ent.entity_phonenumber, 'type': 'tel'},
                            {'name': 'fax', 'label': __('Fax'), 'value': ent.entity_fax, 'type': 'tel'},
                            {'name': 'email', 'label': __('Email address'), 'value': ent.entity_email, 'type': 'email'},
                            {'name': 'website', 'label': __('Website'), 'value': ent.entity_website, 'type': 'text'},
                            {'name': 'address', 'label': __('Address'), 'value': ent.entity_address, 'type': 'textarea'},
                            {'name': 'comment', 'label': __('Comments'), 'value': ent.entity_comment, 'type': 'textarea'},
                            {'name': 'postcode', 'label': __('Postal code'), 'value': ent.entity_postcode, 'type': 'text'},
                            {'name': 'town', 'label': __('City'), 'value': ent.entity_town, 'type': 'text'},
                            {'name': 'state', 'label': __('State'), 'value': ent.entity_state, 'type': 'text'},
                            {'name': 'country', 'label': __('Country'), 'value': ent.entity_country, 'type': 'text'},
                        ] %}
                        <div class="col-md-6">
                            <label class="form-label small text-muted fw-semibold mb-1" for="me_entity_{{ field.name }}_{{ ent.entity_id }}">{{ field.label }}</label>
                            {% if field.type == 'textarea' %}
                                <textarea id="me_entity_{{ field.name }}_{{ ent.entity_id }}" name="{{ field.name }}"
                                          class="form-control form-control-sm" rows="2">{{ field.value }}</textarea>
                            {% else %}
                                <input type="{{ field.type }}" id="me_entity_{{ field.name }}_{{ ent.entity_id }}" name="{{ field.name }}"
                                       class="form-control form-control-sm" value="{{ field.value }}">
                            {% endif %}
                        </div>
                        {% endfor %}
                    </div>
                    <dl class="row mb-0">
                        {% else %}
                            {% if ent.entity_comment %}
                            <dt class="col-sm-3 text-sm-end text-muted small fw-semibold col-form-label py-1">{{ __('Comments') }}</dt>
                            <dd class="col-sm-9 col-form-label py-1">{{ ent.entity_comment|nl2br }}</dd>
                            {% endif %}

                            {% if ent.entity_phonenumber %}
                            <dt class="col-sm-3 text-sm-end text-muted small fw-semibold col-form-label py-1">{{ __('Phone') }}</dt>
                            <dd class="col-sm-9 col-form-label py-1">{{ ent.entity_phonenumber }}</dd>
                            {% endif %}

                            {% if ent.entity_fax %}
                            <dt class="col-sm-3 text-sm-end text-muted small fw-semibold col-form-label py-1">{{ __('Fax') }}</dt>
                            <dd class="col-sm-9 col-form-label py-1">{{ ent.entity_fax }}</dd>
                            {% endif %}

                            {% if ent.entity_website %}
                            <dt class="col-sm-3 text-sm-end text-muted small fw-semibold col-form-label py-1">{{ __('Website') }}</dt>
                            <dd class="col-sm-9 col-form-label py-1">
                                {% if ent.entity_website_is_url %}
                                    <a href="{{ ent.entity_website }}" target="_blank" rel="noopener">{{ ent.entity_website }}</a>
                                {% elseif ent.entity_website %}
                                    {{ ent.entity_website }}
                                {% endif %}
                            </dd>
                            {% endif %}

                            {% if ent.entity_email %}
                            <dt class="col-sm-3 text-sm-end text-muted small fw-semibold col-form-label py-1">{{ __('Email address') }}</dt>
                            <dd class="col-sm-9 col-form-label py-1">
                                {% if ent.entity_email %}
                                    <a href="mailto:{{ ent.entity_email }}">{{ ent.entity_email }}</a>
                                {% endif %}
                            </dd>
                            {% endif %}

                            {% if ent.entity_address %}
                            <dt class="col-sm-3 text-sm-end text-muted small fw-semibold col-form-label py-1">{{ __('Address') }}</dt>
                            <dd class="col-sm-9 col-form-label py-1">{{ ent.entity_address|nl2br }}</dd>
                            {% endif %}

                            {% if ent.entity_postcode %}
                            <dt class="col-sm-3 text-sm-end text-muted small fw-semibold col-form-label py-1">{{ __('Postal code') }}</dt>
                            <dd class="col-sm-9 col-form-label py-1">{{ ent.entity_postcode }}</dd>
                            {% endif %}

                            {% if ent.entity_town %}
                            <dt class="col-sm-3 text-sm-end text-muted small fw-semibold col-form-label py-1">{{ __('City') }}</dt>
                            <dd class="col-sm-9 col-form-label py-1">{{ ent.entity_town }}</dd>
                            {% endif %}

                            {% if ent.entity_state %}
                            <dt class="col-sm-3 text-sm-end text-muted small fw-semibold col-form-label py-1">{{ __('State') }}</dt>
                            <dd class="col-sm-9 col-form-label py-1">{{ ent.entity_state }}</dd>
                            {% endif %}

                            {% if ent.entity_country %}
                            <dt class="col-sm-3 text-sm-end text-muted small fw-semibold col-form-label py-1">{{ __('Country') }}</dt>
                            <dd class="col-sm-9 col-form-label py-1">{{ ent.entity_country }}</dd>
                            {% endif %}
                        {% endif %}

                    </dl>

                    {% if ent.can_update %}
                    <div class="mt-3 text-center">
                        <button type="submit" name="update_entity" class="btn btn-primary">
                            <i class="ti ti-device-floppy me-1"></i>
                            {{ __('Update administrative data', 'manageentities') }}
                        </button>
                    </div>
                    {% endif %}
                </form>
                </div>{# /fields #}
                <div class="col-12 col-lg-4">
                {% if ent.logos is not empty or can_edit %}
                <div class="text-muted small fw-semibold mb-2">{{ __('Logo') }}</div>
                <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
                    {% for logo_src in ent.logos %}
                        <img src="{{ logo_src }}" alt="{{ __('Picture') }}" class="border rounded p-1" style="max-height:80px; max-width:100%;">
                    {% else %}
                        <span class="text-muted small">{{ __('No picture uploaded', 'manageentities') }}</span>
                    {% endfor %}
                </div>
                {% if can_edit %}
                <form method="post" action="{{ entity_form_url }}" enctype="multipart/form-data">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                    <input type="hidden" name="entities_id" value="{{ ent.entity_id }}">
                    {{ _inputs.file('filename', null) }}
                    <div class="d-flex align-items-center justify-content-between gap-2 mt-2">
                        <small class="text-muted">({{ ent.max_upload }})</small>
                        <button type="submit" name="add" class="btn btn-sm btn-primary">
                            {{ __('Update logo', 'manageentities') }}
                        </button>
                    </div>
                </form>
                {% endif %}
                {% endif %}
                </div>{# /logo #}
                </div>

            </div>{# /card-body #}
        </div>{# /card #}
        {% endfor %}

    </div>{# /col top #}

    {# ── Below — contacts, business, tech leads, project managers on 2 x 2 (once for all entities) ── #}
    <div class="col-12">
    <div class="row row-cols-1 row-cols-lg-2 g-3">

        {# Contacts card — hidden in helpdesk when there are no contacts #}
        {% if contacts is not empty or can_edit_contacts %}
        <div class="col">
        <div class="card h-100">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="ti ti-users me-1"></i>
                    {{ _n('Associated contact', 'Associated contacts', 2) }}
                </h3>
            </div>
            <div class="card-body p-0">
                {% if contacts is not empty %}
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead>
                            <tr>
                                <th>{{ __('Name') }}</th>
                                <th>{{ __('Phone') }}</th>
                                <th>{{ __('Mobile phone') }}</th>
                                <th>{{ __('Email address') }}</th>
                                <th>{{ __('Type') }}</th>
                                {% if can_edit_contacts and is_single %}<th></th>{% endif %}
                            </tr>
                        </thead>
                        <tbody>
                        {% for contact in contacts %}
                            <tr>
                                <td><a href="{{ contact.url }}">{{ contact.name }} {{ contact.firstname }}</a></td>
                                <td>{{ contact.phone }}</td>
                                <td>{{ contact.mobile }}</td>
                                <td>
                                    {% if contact.email %}
                                        <a href="mailto:{{ contact.email }}">{{ contact.email }}</a>
                                    {% endif %}
                                </td>
                                <td>
                                    {{ contact.contact_type }}
                                    {% if is_single and interface != 'helpdesk' %}
                                        {% if contact.is_default %}
                                            <span class="badge bg-green-lt">{{ __('Manager') }}</span>
                                        {% elseif can_edit_contacts %}
                                            <form method="post" action="{{ entity_action_url }}" class="d-inline">
                                                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                                <input type="hidden" name="contacts_id" value="{{ contact.link_id }}">
                                                <input type="hidden" name="entities_id" value="{{ entity_id }}">
                                                <button type="submit" name="contactbydefault" class="btn btn-link btn-sm p-0">{{ __('Manager') }}</button>
                                            </form>
                                        {% endif %}
                                    {% elseif contact.is_default %}
                                        <span class="badge bg-green-lt">{{ __('Manager') }}</span>
                                    {% endif %}
                                </td>
                                {% if can_edit_contacts and is_single %}
                                <td class="text-center">
                                    <form method="post" action="{{ entity_action_url }}" class="d-inline">
                                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                        <input type="hidden" name="id" value="{{ contact.link_id }}">
                                        <button type="submit" name="deletecontacts" class="btn btn-link text-danger p-0" title="{{ __('Delete permanently') }}">
                                            <i class="ti ti-circle-x"></i>
                                        </button>
                                    </form>
                                </td>
                                {% endif %}
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% else %}
                    <p class="text-muted text-center py-3 mb-0">{{ __('No contact', 'manageentities') }}</p>
                {% endif %}

                {% if can_edit_contacts and is_single %}
                <div class="card-footer">
                    <form method="post" action="{{ entity_action_url }}" class="d-flex align-items-center gap-2 flex-wrap">
                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                        <input type="hidden" name="entities_id" value="{{ entity_id }}">
                        <div class="flex-grow-1">{{ 'Contact'|itemtype_dropdown({'name': 'contacts_id'}) }}</div>
                        <a href="{{ contact_form_url }}" target="_blank" title="{{ __('Add') }}">
                            <i class="ti ti-square-plus"></i>
                        </a>
                        <button type="submit" name="addcontacts" class="btn btn-sm btn-primary">{{ __('Add') }}</button>
                    </form>
                </div>
                {% endif %}
            </div>
        </div>
        </div>{# /col #}
        {% endif %}

        {# Business contacts card — hidden in helpdesk when there are no business contacts #}
        {% if business is not empty or can_edit_business %}
        <div class="col">
        <div class="card h-100">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="ti ti-briefcase me-1"></i>
                    {{ _n('Associated commercial', 'Associated business', 2, 'manageentities') }}
                </h3>
            </div>
            <div class="card-body p-0">
                {% if business is not empty %}
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead>
                            <tr>
                                <th>{{ __('Name') }}</th>
                                <th>{{ __('Phone') }}</th>
                                <th>{{ __('Phone') }} 2</th>
                                <th>{{ __('Mobile phone') }}</th>
                                <th>{{ __('Email address') }}</th>
                                {% if can_edit_business and is_single %}<th></th>{% endif %}
                            </tr>
                        </thead>
                        <tbody>
                        {% for bc in business %}
                            <tr>
                                <td><a href="{{ bc.url }}">{{ bc.realname }} {{ bc.firstname }}</a></td>
                                <td>{{ bc.phone }}</td>
                                <td>{{ bc.phone2 }}</td>
                                <td>{{ bc.mobile }}</td>
                                <td>
                                    {% if bc.email %}
                                        <a href="mailto:{{ bc.email }}">{{ bc.email }}</a>
                                    {% endif %}
                                </td>
                                {% if can_edit_business and is_single %}
                                <td class="text-center">
                                    <form method="post" action="{{ entity_action_url }}" class="d-inline">
                                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                        <input type="hidden" name="id" value="{{ bc.link_id }}">
                                        <button type="submit" name="deletebusiness" class="btn btn-link text-danger p-0" title="{{ __('Delete permanently') }}">
                                            <i class="ti ti-circle-x"></i>
                                        </button>
                                    </form>
                                </td>
                                {% endif %}
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% else %}
                    <p class="text-muted text-center py-3 mb-0">{{ __('No business contact', 'manageentities') }}</p>
                {% endif %}

                {% if can_edit_business and is_single %}
                <div class="card-footer">
                    <form method="post" action="{{ entity_action_url }}" class="d-flex align-items-center gap-2 flex-wrap">
                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                        <input type="hidden" name="entities_id" value="{{ entity_id }}">
                        <div class="flex-grow-1">{{ 'User'|itemtype_dropdown({'name': 'users_id', 'right': 'interface'}) }}</div>
                        <a href="{{ user_form_url }}" target="_blank" title="{{ __('Add') }}">
                            <i class="ti ti-square-plus"></i>
                        </a>
                        <button type="submit" name="addbusiness" class="btn btn-sm btn-primary">{{ __('Add') }}</button>
                    </form>
                </div>
                {% endif %}
            </div>
        </div>
        </div>{# /col #}
        {% endif %}

        {{ include('@manageentities/entity/techleads_card.html.twig') }}

        {{ include('@manageentities/entity/projectmanagers_card.html.twig') }}

        {% if dat %}
            {{ include('@manageentities/entity/dat_card.html.twig') }}
        {% endif %}

    </div>{# /row 2 x 2 #}
    </div>{# /col below #}
</div>{# /row #}
