{% import '@manageentities/wizard/fields.html.twig' as wizard_fields %}

<div class="document-block d-flex align-items-center gap-2 mb-2 flex-wrap" data-idx="{{ idx }}">
    <div style="min-width:200px">{{ wizard_fields.field(doccat_field) }}</div>
    <input type="file" name="documents[{{ idx }}][file]"
           class="form-control" style="max-width:320px"
           accept=".pdf,.doc,.docx,.xls,.xlsx,.odt,.ods">
    <button type="button" class="btn btn-sm btn-outline-danger"
            data-me-wizard-action="remove-block" data-block="document" data-idx="{{ idx }}">
        <i class="ti ti-trash"></i>
    </button>
</div>
