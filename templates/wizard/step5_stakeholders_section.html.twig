<div class="wizard-stakeholders-section mt-3" id="stakeholders-section-{{ intervention_idx }}">
    <div class="d-flex align-items-center gap-2 mb-2">
        <h4 class="mb-0">
            <i class="ti ti-users me-1"></i>
            {{ _n('User affected', 'Users affected', 2, 'manageentities') }}
            <small class="text-muted fw-normal ms-1">{{ __('Optional') }}</small>
        </h4>
        {% if credit > 0 %}
        <span class="ms-auto text-muted small" id="remaining-label-{{ intervention_idx }}">
            {{ __('Remaining', 'manageentities') }} :
            <strong id="remaining-days-{{ intervention_idx }}">{{ remaining_days|number_format(2) }}</strong>
            / {{ credit|number_format(2) }} {{ __('days', 'manageentities') }}
        </span>
        {% endif %}
    </div>

    <div id="stakeholders-list-{{ intervention_idx }}">
        {% for sh in stakeholders %}
        <div class="d-flex align-items-center gap-2 mb-1 stakeholder-row" data-id="{{ sh.id }}">
            <span class="badge bg-outline-secondary">{{ sh.user_name }}</span>
            <span class="text-muted small">{{ sh.number_affected_days|number_format(2) }} {{ _n('day', 'days', sh.number_affected_days, 'manageentities') }}</span>
            <button type="button" class="btn btn-sm btn-outline-danger"
                onclick="wizardDeleteStakeholder({{ sh.id }}, this, '{{ wizard_url }}')">
                <i class="ti ti-trash"></i>
            </button>
        </div>
        {% endfor %}
    </div>

    {# Inline add form — hidden when no days remain (no d-flex: Bootstrap !important would override display:none) #}
    <div class="align-items-center gap-2 mt-2 flex-wrap" id="stakeholders-form-{{ intervention_idx }}"
        style="{{ credit > 0 and remaining_days is not null and remaining_days <= 0 ? 'display:none' : 'display:flex' }}">
        <div style="min-width:220px">{{ user_html|raw }}</div>
        <input type="number" step="0.5" min="0" max="{{ remaining_days }}"
            id="new_nb_days_{{ intervention_idx }}"
            class="form-control" style="width:110px"
            placeholder="{{ __('Days', 'manageentities') }}">
        <button type="button" class="btn btn-sm btn-outline-secondary"
            onclick="wizardAddStakeholder({{ intervention_idx }}, {{ rand }}, '{{ wizard_url }}')">
            <i class="ti ti-plus me-1"></i>{{ __('Add user', 'manageentities') }}
        </button>
    </div>
</div>
