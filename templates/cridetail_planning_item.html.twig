{# Planning event body of a report detail; the core planning expects an HTML string #}
{% if entity_name %}
<strong>{{ _n('Entity', 'Entities', 1) }}</strong> : {{ entity_name }}<br>
{% endif %}
{% if end_date %}
<strong>{{ __('End date') }}</strong> : {{ end_date }}<br>
{% endif %}
{% if user_name %}
<strong>{{ __('User') }}</strong> : {{ user_name }}<br>
{% endif %}
{% if duration %}
<strong>{{ __('Total duration') }}</strong> : {{ duration }}<br>
{% endif %}
{% if complete %}
<div class="event-description">{{ content }}</div>
{% else %}
{# showToolTip() output: its content is escaped in PHP before being wrapped #}
{{ tooltip_html|raw }}
{% endif %}
