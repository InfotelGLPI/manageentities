{% import "components/form/fields_macros.html.twig" as fields %}

{# The intervention type reloads the existing prices: public/scripts/criprice.js #}
<div class="asset" data-me-criprice-form="{{ {ajax_url: ajax_url, entities_id: entities_id}|json_encode }}">
    {% include("components/form/header.html.twig") %}

    <input type="hidden" name="plugin_manageentities_contractdays_id" value="{{ contractdays_id }}">
    <input type="hidden" name="entities_id" value="{{ entities_id }}">

    <div class="card-body d-flex flex-wrap gap-3 pt-0">
        <div class="col-12">
            <div class="row flex-row">

                {# Intervention type #}
                {{ fields.dropdownField('GlpiPlugin\\Manageentities\\CriType', 'plugin_manageentities_critypes_id',
                    item.fields['plugin_manageentities_critypes_id'],
                    _n('Intervention type', 'Intervention types', 1, 'manageentities'), {
                    'required': true,
                    'entity': entities_id,
                    'used': used_critypes,
                    'on_change': change_event_js,
                }) }}

                {# Price #}
                {{ fields.textField('price', price, price_label, {
                    'required': true
                }) }}

                {# Is default #}
                {{ fields.dropdownYesNo('is_default', is_default, __('Is default', 'manageentities')) }}

                {# Select an existing price: the container is refilled by ajax/criprice.php #}
                {% set select_price_with_div %}
                    <div data-me-criprice-prices>
                        {% do call('Dropdown::showFromArray', ['select_critype', select_prices, {
                            'on_change': change_event_js,
                        }]) %}
                    </div>
                {% endset %}
                {{ fields.field('select_critype', select_price_with_div,
                    __('Select an existing price', 'manageentities')) }}

            </div>
        </div>
    </div>

    {% include("components/form/buttons.html.twig") %}
</div>
