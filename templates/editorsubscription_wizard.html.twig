<div id="me-sub-wizard">
<form method="post" id="me-sub-form" action="{{ page_url }}">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    <input type="hidden" name="action" value="save">
    <input type="hidden" name="sub_id" value="{{ sub_id }}">

    {# Entity #}
    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title mb-0">
                <i class="ti ti-building me-2"></i>{{ _n('Entity', 'Entities', 1) }}
            </h3>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-sm-6">
                    <label class="col-form-label fw-bold">{{ _n('Entity', 'Entities', 1) }} <span class="text-danger">*</span></label>
                    {% if entities_id > 0 %}
                        <input type="hidden" name="entities_id" value="{{ entities_id }}">
                        <input type="text" class="form-control" value="{{ entity_completename }}" readonly disabled>
                    {% else %}
                        {{ 'Entity'|itemtype_dropdown({
                            'name': 'entities_id',
                            'rand': rand,
                            'value': 0,
                            'condition': entity_condition,
                            'on_change': change_event_js,
                        }) }}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {# Subscription fields #}
    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title mb-0">
                <i class="ti ti-certificate me-2"></i>
                <span data-me-sub-title>
                    {% if is_new_sub %}
                        {{ __('Create publisher subscription', 'manageentities') }}
                    {% else %}
                        {{ __('Update publisher subscription', 'manageentities') }}
                    {% endif %}
                </span>
            </h3>
        </div>
        <div class="card-body">
            {# Behaviour: public/scripts/editorsubscription-fields.js #}
            <div class="row g-3" data-me-subscription="{{ {
                'required': true,
                'lookup_url': entities_id == 0 ? lookup_url : null,
                'labels': {
                    'create_title': __('Create publisher subscription', 'manageentities'),
                    'update_title': __('Update publisher subscription', 'manageentities'),
                    'add': _x('button', 'Add'),
                    'update': _x('button', 'Update'),
                    'level_required': __('Subscription level is required.', 'manageentities'),
                },
            }|json_encode }}">
                {% include '@manageentities/editorsubscription_fields.html.twig' with {
                    fields_required: true,
                } %}
            </div>
        </div>
        <div class="card-footer d-flex gap-2 justify-content-between">
            <a href="{{ entity_list_url }}" class="btn btn-outline-secondary">
                <i class="ti ti-x me-1"></i>{{ __('Cancel') }}
            </a>
            <div class="d-flex gap-2">
                {# Submits the separate delete form below (a form cannot be nested) #}
                <button type="submit" form="me-sub-delete-form" data-me-sub-delete
                        class="btn btn-danger{% if is_new_sub %} d-none{% endif %}">
                    <i class="ti ti-trash me-1"></i>{{ _x('button', 'Delete permanently') }}
                </button>
                <button type="submit" class="btn btn-primary">
                    <i class="ti ti-device-floppy me-1"></i>
                    <span data-me-sub-submit-label>{% if is_new_sub %}{{ _x('button', 'Add') }}{% else %}{{ _x('button', 'Update') }}{% endif %}</span>
                </button>
            </div>
        </div>
    </div>

</form>

<form method="post" id="me-sub-delete-form" action="{{ page_url }}"
      data-me-sub-delete-form="{{ __('Are you sure you want to permanently delete this subscription?', 'manageentities') }}">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    <input type="hidden" name="action" value="delete">
    <input type="hidden" name="sub_id" value="{{ sub_id }}">
</form>
</div>
