{# Subscription switches of the "Update subscription fields" massive action on contracts #}
<div class="d-flex flex-wrap gap-4 my-2">
    {% for name, label in fields %}
        <div class="form-check form-switch">
            <input type="hidden" name="{{ name }}" value="0">
            <input type="checkbox" class="form-check-input" name="{{ name }}" value="1" id="ma_{{ name }}">
            <label class="form-check-label" for="ma_{{ name }}">{{ label }}</label>
        </div>
    {% endfor %}
</div>
<button type="submit" name="massiveaction" class="btn btn-primary mt-2">{{ _x('button', 'Update') }}</button>
