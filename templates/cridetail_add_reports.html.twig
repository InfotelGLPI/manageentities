{% if show_wrapper %}
<div id="{{ wrapper_id }}">
    <table class="tab_cadre_fixe">
        <tr class="tab_bg_1">
            <th>{{ _n('Intervention report', 'Intervention reports', 1, 'manageentities') }}</th>
        </tr>
        <tr class="tab_bg_1">
            <td class="center">
{% endif %}

                {% if show_action %}
                    <button type="button" name="showCriForm" class="btn btn-primary"
                            onclick="manageentities_loadCriForm('showCriForm', '{{ modal }}', {{ params|json_encode }});">
                        {{ title }}
                    </button>
                {% endif %}
                &nbsp;
                {% if show_delete %}
                    <form method="post" name="cridetail_form{{ rand }}" id="cridetail_form{{ rand }}"
                          action="{{ delete_url }}" style="display:inline">
                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                        <input type="hidden" name="documents_id" value="{{ documents_id }}">
                        <button type="submit" name="purgedoc" class="btn btn-danger">
                            {{ _x('button', 'Delete permanently') }}
                        </button>
                    </form>
                {% endif %}

{% if show_wrapper %}
            </td>
        </tr>
    </table>
</div>
{% endif %}
