{% import 'components/form/fields_macros.html.twig' as fields %}

{% set row = {'field_class': 'col-12', 'label_class': 'col-sm-4', 'input_class': 'col-sm-8', 'align_label_right': false} %}
{% set half_hours = {
    'min': 0,
    'max': 23.5 * constant('HOUR_TIMESTAMP'),
    'step': 30 * constant('MINUTE_TIMESTAMP'),
    'emptylabel': '0h',
} %}

<form name="form" method="post" action="{{ form_url }}">
    <div class="card mb-3">
        <div class="card-header d-flex align-items-center gap-2">
            <i class="ti ti-file-report"></i>
            <strong>{{ __('Setup for Generate Intervention report', 'manageentities') }}</strong>
        </div>
        <div class="card-body">
            {{ fields.dropdownYesNo('non_accomplished_tasks', config.non_accomplished_tasks, __('Use Non-accomplished tasks informations', 'manageentities'), row) }}

            {{ fields.dropdownYesNo('get_pdf_cri', config.get_pdf_cri, __('Display PDF', 'manageentities'), row) }}

            {{ fields.dropdownArrayField('ticket_state', config.ticket_state, ticket_statuses, __('State of ticket created', 'manageentities'), row) }}

            {{ fields.dropdownTimestampField('default_duration', config.default_duration, __('Default duration', 'manageentities'), row|merge({
                'min': 0,
                'max': 50 * constant('HOUR_TIMESTAMP'),
                'emptylabel': __('Specify an end date'),
            })) }}

            {{ fields.dropdownTimestampField('default_time_am', config.default_time_am, __('Default time AM', 'manageentities'), row|merge(half_hours)) }}

            {{ fields.dropdownTimestampField('default_time_pm', config.default_time_pm, __('Default time PM', 'manageentities'), row|merge(half_hours)) }}

            {{ fields.dropdownYesNo('disable_date_header', config.disable_date_header, __('Disable creation date in header of PDF', 'manageentities'), row) }}

            <div class="alert alert-warning">
                <i class="ti ti-alert-triangle me-2"></i>
                {{ __('Warning: changing the configuration daily or hourly impacts the types of contract', 'manageentities') }}
            </div>
        </div>
        <div class="card-footer d-flex justify-content-end">
            <input type="hidden" name="id" value="1">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <button type="submit" name="update_config" class="btn btn-primary">
                <i class="ti ti-device-floppy me-1"></i>
                {{ _x('button', 'Save') }}
            </button>
        </div>
    </div>
</form>
