{# Gauges of the unbilled interventions, one card per client (DirectHelpdesk::getDashboardData()).
 # Also included in the helpdesk "General follow-up" tab, where it sits in a half-width column.
 # Gauge init reads the data-me-* attributes below (public/scripts/directhelpdesk-gauges.js);
 # each gauge needs a sized container, hence the fixed height. col_class narrows the grid for
 # a narrow host column. #}
<div class="container-fluid px-0 mb-3" data-me-gauges="1" data-me-hour="{{ hour }}" data-me-hours="{{ hours }}">
    <div class="row row-cards g-3">
        {% for card in cards %}
            <div class="{{ col_class|default('col-12 col-md-6 col-xl-4 col-xxl-3') }}">
                <div class="card h-100">
                    <div class="card-header">
                        <h3 class="card-title text-truncate" title="{{ card.name }}">
                            <i class="ti ti-building me-2"></i>{{ card.name }}
                        </h3>
                    </div>
                    <div class="card-body p-2">
                        <div id="container{{ card.entities_id }}" style="height: 220px; width: 100%;"
                             data-me-gauge="{{ card.gauge|json_encode }}"></div>
                        {% if card.techs is not empty %}
                            <div class="d-flex flex-wrap gap-1 justify-content-center">
                                {% for tech in card.techs %}
                                    <span class="badge bg-secondary-lt">
                                        <i class="ti ti-user me-1"></i>{{ tech }}
                                    </span>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                    {% if card.show_create %}
                        <div class="card-footer text-end">
                            {% if card.can_create %}
                                <button type="button" class="btn btn-danger" data-bs-toggle="modal"
                                        data-bs-target="#createticket{{ card.entities_id }}">
                                    <i class="ti ti-ticket me-1"></i>{{ __('Create a ticket') }}
                                </button>
                            {% else %}
                                <button type="button" class="btn btn-outline-secondary" disabled>
                                    <i class="ti ti-ticket me-1"></i>{{ __('Create a ticket') }}
                                </button>
                            {% endif %}
                            {{ card.modal|raw }}
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>
</div>
