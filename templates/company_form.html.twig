{% import "components/form/fields_macros.html.twig" as fields %}

{% set bg = "" %}
{% if item.isDeleted() %}
    {% set bg = "asset-deleted" %}
{% endif %}

<div class="asset {{ bg }}">
    {% include("components/form/header.html.twig") %}

    <div class="card-body">
        <div class="row">
            {{ fields.textField(
                'name',
                item.fields['name'],
                _n('Company', 'Companies', 1, 'manageentities')
            ) }}

            {{ fields.dropdownField(
                'Entity',
                'entities_id',
                item.fields['entities_id'],
                _n('Entity', 'Entities', 1),
                {'right': 'all'}
            ) }}

            {{ fields.dropdownYesNo(
                'is_recursive',
                item.fields['is_recursive'],
                __('Recursive')
            ) }}

            {{ fields.textareaField(
                'address',
                item.fields['address'],
                __('Address'),
                {'enable_richtext': false, 'rows': 5}
            ) }}

            {{ fields.textareaField(
                'comment',
                item.fields['comment'],
                _n('Comment', 'Comments', get_plural_number()),
                {'enable_richtext': false, 'rows': 5}
            ) }}

            {% if logo_url %}
                {{ fields.imageField(
                    'logo_preview',
                    logo_url,
                    __('Picture'),
                    {'height': 50, 'alt': __('Picture')}
                ) }}
            {% endif %}

            {# "filename" is the name Html::file() posts back as _filename #}
            {{ fields.fileField(
                'filename',
                null,
                __('Logo (format JPG or JPEG)', 'manageentities'),
                {'multiple': false, 'onlyimages': true}
            ) }}
        </div>
    </div>

    {% include("components/form/buttons.html.twig") %}
</div>
