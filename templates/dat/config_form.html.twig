{% import 'components/form/fields_macros.html.twig' as fields %}

{# "DAT" tab of the configuration (DatConfig).
 #
 # config   - row of glpi_plugin_manageentities_configs
 # template - {kind, label, uploaded, url} Word template of the DAT (PresaleTemplate::DAT)
 #}

{% set row = {'field_class': 'col-12', 'label_class': 'col-sm-4', 'input_class': 'col-sm-8', 'align_label_right': false} %}

<form name="form" method="post" action="{{ form_url }}" enctype="multipart/form-data">
    <div class="card mb-3">
        <div class="card-header d-flex align-items-center gap-2">
            <i class="ti ti-file-settings"></i>
            <strong>{{ __('Technical architecture documents', 'manageentities') }}</strong>
        </div>
        <div class="card-body">
            {{ fields.dropdownField('DocumentCategory', 'dat_documentcategories_id', config.dat_documentcategories_id|default(0), __('Category of the generated DAT', 'manageentities'), row) }}

            {# Word template: not shipped with the plugin, uploaded here and stored in
               files/_plugins/manageentities/presale #}
            <div class="alert alert-info">
                <i class="ti ti-info-circle me-1"></i>
                {{ __('Upload the Word template of the technical architecture documents: no template is shipped with the plugin. The placeholders it can hold are listed in the documentation of the plugin.', 'manageentities') }}
            </div>
            {% set field %}
                <input type="file" class="form-control" name="presale_template[{{ template.kind }}]" id="presale_template_{{ template.kind }}"
                       accept=".docx,application/vnd.openxmlformats-officedocument.wordprocessingml.document">
                <div class="d-flex align-items-center flex-wrap gap-2 mt-1 small">
                    {% if template.uploaded %}
                        <span class="badge bg-green-lt">{{ __('Uploaded template', 'manageentities') }}</span>
                        <a href="{{ template.url }}"><i class="ti ti-download me-1"></i>{{ __('Download') }}</a>
                        <label class="form-check form-check-inline mb-0 ms-2">
                            <input type="checkbox" class="form-check-input" name="presale_template_delete[{{ template.kind }}]" value="1">
                            <span class="form-check-label">{{ __('Delete') }}</span>
                        </label>
                    {% else %}
                        <span class="badge bg-orange-lt">{{ __('No template: the DAT cannot be generated', 'manageentities') }}</span>
                    {% endif %}
                </div>
            {% endset %}
            {{ fields.field('presale_template[' ~ template.kind ~ ']', field, template.label, row|merge({
                'id': 'presale_template_' ~ template.kind,
            })) }}
        </div>
        <div class="card-footer d-flex justify-content-end">
            <input type="hidden" name="id" value="1">
            <button type="submit" name="update_config" class="btn btn-primary">
                <i class="ti ti-device-floppy me-1"></i>
                {{ _x('button', 'Save') }}
            </button>
        </div>
    </div>
</form>
