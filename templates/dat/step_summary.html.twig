{# Step 8 — summary of the DAT before its generation.
 #
 # client, author, dat_date, version - general information
 # servers        - [{name, internal_name, ip, role}]
 # section_steps  - {step: [{label, kind, value}]}
 # step_labels    - {step: label}
 # template_ready - whether the Word template is uploaded
 # config_url     - DAT tab of the configuration, empty without the right
 # can_generate   - whether the user may generate it (button of the layout)
 # document       - {name, url, version} last generated version, null when none
 #}

{% if document %}
    <div class="alert alert-success d-flex align-items-center flex-wrap gap-2">
        <i class="ti ti-file-check"></i>
        <span>{{ __('Last generated version: %s', 'manageentities')|format(document.version) }}</span>
        <a href="{{ document.url }}" class="ms-1"><i class="ti ti-download me-1"></i>{{ document.name }}</a>
    </div>
{% endif %}

{% if not template_ready %}
    <div class="alert alert-warning">
        <i class="ti ti-alert-triangle me-1"></i>
        {{ __('No Word template uploaded in the configuration (DAT tab): the document cannot be generated.', 'manageentities') }}
        {% if config_url is not empty %}
            <a href="{{ config_url }}" class="ms-1">{{ __('Open the configuration', 'manageentities') }}</a>
        {% endif %}
    </div>
{% endif %}

<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title"><i class="ti ti-info-circle me-1"></i>{{ step_labels[1] }}</h3>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">{{ __('Client', 'manageentities') }}</dt><dd class="col-sm-9">{{ client }}</dd>
            <dt class="col-sm-3">{{ __('Author', 'manageentities') }}</dt><dd class="col-sm-9">{{ author }}</dd>
            <dt class="col-sm-3">{{ __('Date') }}</dt><dd class="col-sm-9">{{ dat_date|formatted_date }}</dd>
            <dt class="col-sm-3">{{ __('Version', 'manageentities') }}</dt><dd class="col-sm-9">{{ version }}</dd>
        </dl>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title"><i class="ti ti-server me-1"></i>{{ _n('Server', 'Servers', 2, 'manageentities') }}</h3>
    </div>
    <div class="card-body p-0">
        <table class="table table-sm mb-0">
            <thead>
                <tr>
                    <th>{{ __('DNS name', 'manageentities') }}</th>
                    <th>{{ __('Internal name', 'manageentities') }}</th>
                    <th>{{ __('IP address') }}</th>
                    <th>{{ __('Role') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for server in servers %}
                    <tr><td>{{ server.name }}</td><td>{{ server.internal_name }}</td><td>{{ server.ip }}</td><td>{{ server.role }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% for step, rows in section_steps %}
    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title">{{ step }}. {{ step_labels[step] }}</h3>
        </div>
        <div class="card-body">
            {% for row in rows %}
                <h4 class="mb-1">{{ row.label }}</h4>
                {% if row.value is empty %}
                    <p class="text-muted fst-italic">{{ __('Not filled in', 'manageentities') }}</p>
                {% elseif row.kind == 'richtext' %}
                    <div class="mb-3">{{ row.value|safe_html }}</div>
                {% elseif row.kind == 'code' %}
                    <pre class="mb-3">{{ row.value }}</pre>
                {% else %}
                    <p>{{ row.value }}</p>
                {% endif %}
            {% endfor %}
        </div>
    </div>
{% endfor %}
