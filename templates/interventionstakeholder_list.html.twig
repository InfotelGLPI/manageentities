<div class="card mt-3">
    <div class="card-header">
        <h3 class="card-title">
            <i class="ti ti-users me-2"></i>
            {{ _n('Current stakeholder', 'Current stakeholders', 2, 'manageentities') }}
            <span class="badge bg-secondary-lt ms-1">{{ entries|length }}</span>
        </h3>
    </div>
    <div class="card-body p-0">
        {# Read by public/scripts/interventionstakeholder.js (delete and AJAX refresh) #}
        <table class="table table-hover table-sm card-table" id="list_stakeholders{{ id_to_use }}"
               data-me-url="{{ ajax_url }}"
               data-me-contractdays-id="{{ id_to_use }}"
               data-me-empty-label="{{ __('No stakeholders have been affected yet.', 'manageentities') }}"
               data-me-delete-label="{{ __('Delete', 'manageentities') }}"
               data-me-confirm-label="{{ __('This action is irreversible. Continue ?', 'manageentities') }}">
            <thead>
                <tr>
                    <th>{{ __('User') }}</th>
                    <th>{{ __('Affected to', 'manageentities') }}</th>
                    {% if can_create %}<th></th>{% endif %}
                </tr>
            </thead>
            <tbody>
                {% if entries|length > 0 %}
                    {% for entry in entries %}
                    <tr id="{{ entry.row_id }}">
                        <td><a href="{{ entry.user_url }}" target="_blank">{{ entry.user_name }}</a></td>
                        {# The id is targeted by the JS refreshing the number of days after an update #}
                        <td><span id="td_user_id{{ entry.stakeholder_id }}">{{ entry.nb_days }}&nbsp;{{ _n('Day', 'Days', 2) }}</span></td>
                        {% if can_create %}
                        <td class="text-end">
                            <i title="{{ __('Delete', 'manageentities') }}" class="ti ti-trash pointer"
                               data-me-stakeholder-delete="{{ entry.stakeholder_id }}"></i>
                        </td>
                        {% endif %}
                    </tr>
                    {% endfor %}
                {% else %}
                    <tr id="empty_stakeholders{{ id_to_use }}">
                        <td colspan="{{ can_create ? 3 : 2 }}" class="text-muted p-3">
                            {{ __('No stakeholders have been affected yet.', 'manageentities') }}
                        </td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
    </div>
</div>

